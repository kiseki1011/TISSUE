# Tissue self-host / production .env
#
# Using the next script generates secrets, builds & starts everything.
#   ./install.sh
#
# (For local development from an IDE, use .env.local.example instead.)

# ------------------------------------------------------------------------------
# COMPOSE PROFILES
# ------------------------------------------------------------------------------
#   selfhost-db     :   run a postgres container
#   selfhost-cache  :   run a redis container (only needed if `USE_REDIS=true`)
#   observability   :   run the observability stack
# Leave empty to use external managed infra (RDS / ElastiCache).
# Point the endpoints below at those addresses instead.
COMPOSE_PROFILES=selfhost-db

# ------------------------------------------------------------------------------
# Database
# install.sh replaces POSTGRES_PASSWORD with a generated one.
# ------------------------------------------------------------------------------
POSTGRES_URL=jdbc:postgresql://postgres:5432/tissue
POSTGRES_USERNAME=tissue
POSTGRES_PASSWORD=changeme
POSTGRES_DB=tissue

# ------------------------------------------------------------------------------
# Redis (optional)
# Off by default. Uses in-application Caffeine cache.
# To enable, set `USE_REDIS=true` and add `selfhost-cache` to COMPOSE_PROFILES
# (or point REDIS_HOST at an external Redis).
# ------------------------------------------------------------------------------
USE_REDIS=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# Security (required)
# JWT signing secret. Must be >= 32 bytes.
# Generate: `openssl rand -hex 32`
# (install.sh sets this automatically. Required if you create .env by hand.)
# ------------------------------------------------------------------------------
JWT_SECRET=

# ------------------------------------------------------------------------------
# App Overrides
# ------------------------------------------------------------------------------
# Public URL the instance is served at (used in emails, links, cookies).
TISSUE_BASE_URL=http://localhost:8080

# Comma-separated browser origins allowed to call the API (web clients).
# The terminal (TUI) client does not need this.
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Self signup. Closed by default. Initial user can always sign up (admin bootstrap).
TISSUE_SIGNUP_ENABLED=false

# ------------------------------------------------------------------------------
# Email / SMTP
# Configure to enable signup verification & notifications.
# Until set, the app still boots but cannot send mail.
# ------------------------------------------------------------------------------
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
TISSUE_EMAIL_SENDER=noreply@{your-tissue-domain}

# ------------------------------------------------------------------------------
# Storage
# local | s3
# ------------------------------------------------------------------------------
TISSUE_STORAGE_TYPE=local
TISSUE_LOCAL_STORAGE_PATH=/var/tissue/storage

# ------------------------------------------------------------------------------
# Reverse proxy
# Trusted proxy IP range for X-Forwarded-* headers (ex: 10.0.0.0/8).
# ------------------------------------------------------------------------------
TRUSTED_PROXY_IP=

# ------------------------------------------------------------------------------
# App container resources (compose deploy.resources.limits)
# Tune according to your setup.
# ------------------------------------------------------------------------------
APP_MEMORY_LIMIT=2g
APP_CPU_LIMIT=2

# ------------------------------------------------------------------------------
# Performance tuning
# Defaults are safe. Raise for higher concurrency.
# ------------------------------------------------------------------------------
# DB connection pool — keep below postgres max_connections (default 100).
HIKARI_MAX_POOL_SIZE=20
HIKARI_MIN_IDLE=10
TOMCAT_MAX_THREADS=200

# Java 21 virtual threads (for IO-bound workloads). Disable on compatibility issues.
VIRTUAL_THREADS_ENABLED=true

JAVA_OPTS="-XX:MaxRAMPercentage=75 -XX:+UseG1GC -XX:+UseStringDeduplication -XX:+ExitOnOutOfMemoryError -Djava.security.egd=file:/dev/./urandom -Duser.timezone=UTC"

# ------------------------------------------------------------------------------
# Observability
# Use with the compose.observability.yaml overlay.
# Grafana admin (change before exposing). Loki push endpoint for a remote monitoring host.
# ------------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
LOKI_ENDPOINT=
