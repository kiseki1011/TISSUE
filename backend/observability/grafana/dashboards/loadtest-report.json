{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "uid": "tissue-loadtest-report",
  "title": "Tissue Loadtest Report",
  "tags": ["tissue", "loadtest"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-30m", "to": "now"},
  "templating": {
    "list": [
      {
        "current": {"selected": false, "text": "All", "value": "$__all"},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "definition": "label_values(k6_http_reqs_total, testid)",
        "hide": 0,
        "includeAll": true,
        "label": "testid",
        "multi": true,
        "name": "testid",
        "options": [],
        "query": {"query": "label_values(k6_http_reqs_total, testid)", "refId": "PrometheusVariableQueryEditor-VariableQuery"},
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {"selected": false, "text": "All", "value": "$__all"},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "definition": "label_values(k6_http_reqs_total{testid=~\"$testid\"}, op)",
        "hide": 0,
        "includeAll": true,
        "label": "op",
        "multi": true,
        "name": "op",
        "options": [],
        "query": {"query": "label_values(k6_http_reqs_total{testid=~\"$testid\"}, op)", "refId": "PrometheusVariableQueryEditor-VariableQuery"},
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "id": 100,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "RPS (sum)",
      "id": 1,
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "expr": "sum(rate(k6_http_reqs_total{testid=~\"$testid\"}[30s]))",
        "refId": "A",
        "legendFormat": "rps"
      }],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "graphMode": "area", "colorMode": "value"},
      "fieldConfig": {"defaults": {"unit": "reqps", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}}}
    },
    {
      "type": "stat",
      "title": "Error rate",
      "id": 2,
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "expr": "sum(rate(k6_http_req_failed_rate{testid=~\"$testid\"}[30s])) / sum(rate(k6_http_reqs_total{testid=~\"$testid\"}[30s]))",
        "refId": "A",
        "legendFormat": "error"
      }],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "graphMode": "area"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "yellow", "value": 0.01}, {"color": "red", "value": 0.05}]}}}
    },
    {
      "type": "stat",
      "title": "Active VUs",
      "id": 3,
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "expr": "sum(k6_vus{testid=~\"$testid\"})",
        "refId": "A",
        "legendFormat": "vus"
      }],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "graphMode": "area"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "blue"}]}}}
    },
    {
      "type": "stat",
      "title": "Total iterations",
      "id": 4,
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "expr": "sum(k6_iterations_total{testid=~\"$testid\"})",
        "refId": "A",
        "legendFormat": "iter"
      }],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "graphMode": "area"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "purple"}]}}}
    },
    {
      "type": "row",
      "title": "Latency (per endpoint)",
      "id": 101,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "p95 by endpoint (ms)",
      "id": 10,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "expr": "k6_http_req_duration_p95{testid=~\"$testid\", op=~\"$op\"} * 1000",
        "refId": "A",
        "legendFormat": "{{op}}"
      }],
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "options": {"legend": {"showLegend": true, "displayMode": "table", "calcs": ["max", "lastNotNull"]}, "tooltip": {"mode": "multi"}}
    },
    {
      "type": "timeseries",
      "title": "p99 by endpoint (ms)",
      "id": 11,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "expr": "k6_http_req_duration_p99{testid=~\"$testid\", op=~\"$op\"} * 1000",
        "refId": "A",
        "legendFormat": "{{op}}"
      }],
      "fieldConfig": {"defaults": {"unit": "ms"}},
      "options": {"legend": {"showLegend": true, "displayMode": "table", "calcs": ["max", "lastNotNull"]}, "tooltip": {"mode": "multi"}}
    },
    {
      "type": "table",
      "title": "Endpoint summary (max p95 / max p99 over current window)",
      "id": 12,
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 14},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "max by (op) (k6_http_req_duration_p95{testid=~\"$testid\", op=~\"$op\"}) * 1000", "refId": "A", "format": "table", "instant": true, "legendFormat": "p95"},
        {"expr": "max by (op) (k6_http_req_duration_p99{testid=~\"$testid\", op=~\"$op\"}) * 1000", "refId": "B", "format": "table", "instant": true, "legendFormat": "p99"},
        {"expr": "sum by (op) (k6_http_reqs_total{testid=~\"$testid\", op=~\"$op\"})", "refId": "C", "format": "table", "instant": true, "legendFormat": "reqs"}
      ],
      "transformations": [
        {"id": "merge", "options": {}},
        {"id": "organize", "options": {"excludeByName": {"Time": true, "__name__": true, "instance": true, "job": true, "testid": true}, "renameByName": {"Value #A": "p95 (ms)", "Value #B": "p99 (ms)", "Value #C": "total reqs"}}}
      ],
      "fieldConfig": {"defaults": {"custom": {"align": "auto"}}, "overrides": [{"matcher": {"id": "byName", "options": "p95 (ms)"}, "properties": [{"id": "unit", "value": "ms"}, {"id": "decimals", "value": 0}]}, {"matcher": {"id": "byName", "options": "p99 (ms)"}, "properties": [{"id": "unit", "value": "ms"}, {"id": "decimals", "value": 0}]}]}
    },
    {
      "type": "row",
      "title": "App health (during test)",
      "id": 102,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 24},
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "JVM heap used (MB)",
      "id": 20,
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 25},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "expr": "jvm_memory_used_bytes{application=\"tissue\", area=\"heap\"} / 1024 / 1024",
        "refId": "A",
        "legendFormat": "{{id}}"
      }],
      "fieldConfig": {"defaults": {"unit": "decmbytes"}}
    },
    {
      "type": "timeseries",
      "title": "Hikari pool (active / idle / pending)",
      "id": 21,
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 25},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "hikaricp_connections_active{application=\"tissue\"}",  "refId": "A", "legendFormat": "active"},
        {"expr": "hikaricp_connections_idle{application=\"tissue\"}",    "refId": "B", "legendFormat": "idle"},
        {"expr": "hikaricp_connections_pending{application=\"tissue\"}", "refId": "C", "legendFormat": "pending"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Tomcat threads busy",
      "id": 22,
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 25},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "expr": "tomcat_threads_busy_threads{application=\"tissue\"}",
        "refId": "A",
        "legendFormat": "busy"
      }]
    }
  ]
}
