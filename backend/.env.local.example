# Local development env
#
# Two consumers read .env:
#   1. docker compose (compose.yaml)    :   picks which infra containers spin up
#   2. app run with the `local` profile :   fills config placeholders, via `spring.config.import`
#      from your IDE                        in application-local.yml
#
# Usage (Docker must be running):
#   Just run the app from the IDE with SPRING_PROFILES_ACTIVE=local.
#   `spring-boot-docker-compose` auto-starts compose.yaml on boot and stops it on exit.
#   No need to run `docker compose up -d` yourself.
#   (You still can, to keep infra up independently of the app.)
#
# Real OS env vars / IDE run-config vars override anything set here. Keys left commented
# fall back to the defaults in application-local.yml / application.yml.

# ------------------------------------------------------------------------------
# Optional Infra
# (default) COMPOSE_PROFILES=       :  PostgreSQL + Mailpit
#           COMPOSE_PROFILES=redis  :  PostgreSQL + Mailpit + Redis
# (If using redis, set `USE_REDIS=true` below)
# ------------------------------------------------------------------------------

COMPOSE_PROFILES=

# ------------------------------------------------------------------------------
# Application Overrides
# (DB url/credentials and the dev JWT secret are fixed in application-local.yml)
# ------------------------------------------------------------------------------

# Redis
# Leave `false` to use in-application Caffeine cache (no redis container needed).
USE_REDIS=false

# Tissue signup
# Closed by default. The initial user can always sign up (admin bootstrap).
# Use `true` to register extra accounts locally (for example, multi-user testing).
TISSUE_SIGNUP_ENABLED=false

# Sender shown on outgoing mail (delivered to mailpit at http://localhost:8025).
TISSUE_EMAIL_SENDER=noreply@trytissue.dev

# ------------------------------------------------------------------------------
# OIDC (only when testing OIDC authentication mode locally)
# Switch the instance to OIDC and point it at your IdP. Leave unset for normal LOCAL auth mode.
# ------------------------------------------------------------------------------

# TISSUE_AUTH_MODE=OIDC
# TISSUE_AUTH_OIDC_ISSUER_URI=https://your-idp.example.com/
# TISSUE_AUTH_OIDC_CLIENT_ID=your-client-id
# TISSUE_AUTH_OIDC_CLIENT_SECRET=your-client-secret      # leave empty for public / native apps
# TISSUE_AUTH_OIDC_PROVIDER_NAME=your-idp-name
