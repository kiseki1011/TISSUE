# Local development env — used by compose.yaml.
#
# Usage:
#   cp .env.local.example .env
#   docker compose up -d
#
# The app itself is run from the IDE with SPRING_PROFILES_ACTIVE=local;
# its defaults live in application-local.yml.
# This file is only for tweaking which infra containers spin up.

# ------------------------------------------------------------------------------
# COMPOSE PROFILES — optional services
# ------------------------------------------------------------------------------
# Default infra: postgres + mailpit.
# Enable redis by setting `redis` here (and USE_REDIS=true in your IDE run config).
#
# COMPOSE_PROFILES=redis
COMPOSE_PROFILES=
