# Example .env for Tissue
#
# docker compose will read the .env file in the same directory automatically.
# When running from an IDE, inject env vars directly or set SPRING_PROFILES_ACTIVE
# the defaults in application-{profile}.yml will take over.
#
# ─────────────────────────────────────────────────────────────────────────────
# COMPOSE PROFILES — selects which services docker spins up.
# (Affects compose.loadtest.yaml only. compose.yaml has its own redis profile.)
# ─────────────────────────────────────────────────────────────────────────────
# selfhost-db    : postgres container
# selfhost-cache : redis container
#
# Full self-host:
COMPOSE_PROFILES=selfhost-db,selfhost-cache

#
# External infra (RDS/ElastiCache/etc.): leave empty and point the endpoints below to the external addresses.
# COMPOSE_PROFILES=
#
# ──────────────────────────────────────────────────────────────────────────────
# DB
# ──────────────────────────────────────────────────────────────────────────────
POSTGRES_URL=jdbc:postgresql://postgres:5432/tissue
POSTGRES_USERNAME=tissue
POSTGRES_PASSWORD=tissue
POSTGRES_DB=tissue

# ──────────────────────────────────────────────────────────────────────────────
# Redis — disabled by default. Set USE_REDIS=true to enable cache, then either
# add `selfhost-cache` to COMPOSE_PROFILES or point REDIS_HOST to an external Redis.
# ──────────────────────────────────────────────────────────────────────────────
USE_REDIS=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ──────────────────────────────────────────────────────────────────────────────
# Security — generate JWT_SECRET with: openssl rand -base64 48
# ──────────────────────────────────────────────────────────────────────────────
JWT_SECRET=

# ──────────────────────────────────────────────────────────────────────────────
# App
# ──────────────────────────────────────────────────────────────────────────────
TISSUE_BASE_URL=http://localhost:8080
TISSUE_MULTI_TENANT=false
TISSUE_EMAIL_SENDER=noreply@trytissue.dev

# ──────────────────────────────────────────────────────────────────────────────
# Storage — only `local` is supported for now. S3 support is future work.
# ──────────────────────────────────────────────────────────────────────────────
TISSUE_STORAGE_TYPE=local
TISSUE_LOCAL_STORAGE_PATH=/var/tissue/storage

# ──────────────────────────────────────────────────────────────────────────────
# App container resource limits (compose deploy.resources.limits)
# Tune per host spec: small EC2 → 1g/1, larger → 4g/4
# ──────────────────────────────────────────────────────────────────────────────
APP_MEMORY_LIMIT=2g
APP_CPU_LIMIT=2

# ──────────────────────────────────────────────────────────────────────────────
# Grafana — defaults to admin/admin. Override before exposing beyond localhost.
# ──────────────────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ──────────────────────────────────────────────────────────────────────────────
# Observability — only used when the monitoring stack lives on a different host.
# ──────────────────────────────────────────────────────────────────────────────
# Single host (overlay compose.loadtest.yaml + compose.observability.yaml):
#   leave both unset. alloy pushes to loki:3100, prometheus scrapes app:8081 via docker network.
#
# Split host (app+alloy on one machine, prometheus+loki+grafana on another):
#   - On the APP host's .env (this file): set LOKI_ENDPOINT to the monitoring host's loki URL.
#       LOKI_ENDPOINT=http://192.168.1.10:3100/loki/api/v1/push
#   - On the MONITORING host: edit observability/prometheus/prometheus.yml and replace
#     `app:8081` with the app host's reachable address (e.g. 192.168.1.50:8081).
#     Prometheus does not interpolate env vars in scrape_configs, so this is a file edit.
LOKI_ENDPOINT=
