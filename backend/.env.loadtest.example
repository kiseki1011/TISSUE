# Example .env for Tissue
#
# docker compose will read the .env file in the same directory automatically.
# When running from an IDE, inject env vars directly or set SPRING_PROFILES_ACTIVE
# the defaults in application-{profile}.yml will take over.
#
# ------------------------------------------------------------------------------
# COMPOSE PROFILES
# Selects which services docker spins up.
# (Affects compose.loadtest.yaml only. compose.yaml has its own profile.)
# ------------------------------------------------------------------------------
# selfhost-db    : postgres container
# selfhost-cache : redis container (only needed if USE_REDIS=true)
#
# Default: postgres only — app falls back to Caffeine local cache (no redis container).
# add ,selfhost-cache if redis container is needed.
COMPOSE_PROFILES=selfhost-db

#
# External infra (RDS/ElastiCache/etc)
# Leave empty and point the endpoints below to the external addresses.
# COMPOSE_PROFILES=
#
# -------------------------------------------------------------------------------
# DB
# -------------------------------------------------------------------------------
POSTGRES_URL=jdbc:postgresql://postgres:5432/tissue
POSTGRES_USERNAME=tissue
POSTGRES_PASSWORD=tissue
POSTGRES_DB=tissue

# -------------------------------------------------------------------------------
# Redis
# Disabled by default. Set USE_REDIS=true to enable cache, then either
# add `selfhost-cache` to COMPOSE_PROFILES or point REDIS_HOST to an external Redis.
# -------------------------------------------------------------------------------
USE_REDIS=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# -------------------------------------------------------------------------------
# Security
# Generate JWT_SECRET with: openssl rand -base64 48
# -------------------------------------------------------------------------------
JWT_SECRET=

# -------------------------------------------------------------------------------
# App
# -------------------------------------------------------------------------------
TISSUE_BASE_URL=http://localhost:8080
TISSUE_MULTI_TENANT=false
TISSUE_EMAIL_SENDER=noreply@trytissue.dev

# -------------------------------------------------------------------------------
# Storage
# Only `local` is supported for now. S3 support is future work.
# -------------------------------------------------------------------------------
TISSUE_STORAGE_TYPE=local
TISSUE_LOCAL_STORAGE_PATH=/var/tissue/storage

# -------------------------------------------------------------------------------
# App container resource limits (compose deploy.resources.limits)
# Tune per host spec: small EC2 → 1g/1, larger → 4g/4
# -------------------------------------------------------------------------------
APP_MEMORY_LIMIT=2g
APP_CPU_LIMIT=2

# -------------------------------------------------------------------------------
# Performance tuning
# Defaults are safe; raise for higher concurrency.
# -------------------------------------------------------------------------------
# DB connection pool - postgres `max_connections` default is 100, stay below that.
HIKARI_MAX_POOL_SIZE=20
HIKARI_MIN_IDLE=10

# Tomcat request threads
TOMCAT_MAX_THREADS=200

# Java 21 Virtual Threads
# For IO-bound workloads. Disable if there are compatibility issues.
VIRTUAL_THREADS_ENABLED=true

# JVM tuning. MaxRAMPercentage adapts heap to APP_MEMORY_LIMIT.
JAVA_OPTS="-XX:MaxRAMPercentage=75 -XX:+UseG1GC -XX:+UseStringDeduplication -XX:+ExitOnOutOfMemoryError -Djava.security.egd=file:/dev/./urandom -Duser.timezone=UTC"

# -------------------------------------------------------------------------------
# Grafana - defaults to admin/admin. Override before exposing beyond localhost.
# -------------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# -------------------------------------------------------------------------------
# Observability - only used when the monitoring stack lives on a different host.
# -------------------------------------------------------------------------------
# Single host (overlay compose.loadtest.yaml + compose.observability.yaml):
#   leave both unset. alloy pushes to loki:3100, prometheus scrapes app:8081 via docker network.
#
# Split host (app + alloy on one machine, prometheus + loki + grafana on another):
#   - On the APP host's .env (this file): set LOKI_ENDPOINT to the monitoring host's loki URL.
#       LOKI_ENDPOINT=http://192.168.1.10:3100/loki/api/v1/push
#   - On the MONITORING host: edit observability/prometheus/prometheus.yml and replace
#     `app:8081` with the app host's reachable address (example: 192.168.1.50:8081).
#     Prometheus does not interpolate env vars in scrape_configs, so this is a file edit.
LOKI_ENDPOINT=
