.back-btn {
    width: 3;
    height: 1;
    min-width: 0;
    border: none;
    padding: 0;
    margin: 0;
    background: $primary;
    background-tint: transparent 0%;
    color: $surface;
}

.back-btn:focus {
    background: $accent;
    color: $surface;
    text-style: bold;
}

BracketButton.-primary {
    border: round $primary;
    color: $primary;
    background: transparent;
    background-tint: transparent 0%;
}

BracketButton.-primary:focus {
    border: round $accent;
    color: $accent;
    text-style: bold;
}

BracketButton.-secondary {
    border: round $secondary;
    color: $secondary;
    background: transparent;
    background-tint: transparent 0%;
}

BracketButton.-secondary:focus {
    border: round $accent;
    color: $accent;
    text-style: bold;
}

BracketButton.-success {
    border: round $success;
    color: $success;
    background: transparent;
    background-tint: transparent 0%;
}

BracketButton.-success:focus {
    border: round $accent;
    color: $accent;
    text-style: bold;
}

BracketButton.-oauth {
    border: round $secondary;
    color: $secondary;
    background: transparent;
    background-tint: transparent 0%;
}

BracketButton.-oauth:focus {
    border: round $accent;
    color: $accent;
    text-style: bold;
}
