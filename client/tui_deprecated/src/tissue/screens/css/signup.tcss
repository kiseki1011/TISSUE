#signup-dialog {
    layers: base overlay;
    max-width: 53;
    height: 43;
    padding: 1 4 1 4;
}

#signup-dialog.-auto {
    height: auto;
}

#signup-dialog.-compact {
    height: 26;
}

#signup-dialog.-no-email {
    height: 41;
}

#signup-dialog.-no-email.-compact {
    height: 24;
}

#signup-dialog #back_btn {
    layer: overlay;
    offset: 0 0;
    margin-top: 0;
}

#signup-dialog .logo {
    margin-top: 3;
    margin-bottom: 3;
}

#signup-dialog .subtitle {
    margin-bottom: 3;
}

#signup-dialog .input-field {
    width: 100%;
    margin-bottom: 0;
}

#signup-dialog .status-msg {
    height: 1;
    margin: 0 0 0 0;
    padding-left: 1;
    width: 100%;
    text-align: left;
    color: $text-muted;
}

#signup-dialog .status-msg.waiting {
    color: $warning;
    text-style: italic;
}

#signup-dialog #email-row {
    height: 3;
    width: 100%;
    margin: 0;
}

#signup-dialog #email-row #email {
    width: 4fr;
    height: 3;
    margin: 0;
}

#signup-dialog #verify_btn {
    width: 1fr;
    min-width: 12;
    height: 3;
    margin: 0 0 0 1;
}

#signup-dialog #password {
    margin-top: 1;
}

#signup-dialog #submit_btn {
    width: 100%;
    height: 3;
    margin-top: 1;
    margin-bottom: 0;
}

#signup-dialog.-compact .logo {
    display: none;
}

#signup-dialog.-compact .subtitle {
    margin-bottom: 0;
}

#signup-dialog.-compact .input-field {
    margin-bottom: 0;
}

#signup-dialog.-compact #password {
    margin-top: 0;
}

#signup-dialog.-compact #submit_btn {
    margin-top: 0;
    margin-bottom: 0;
}
