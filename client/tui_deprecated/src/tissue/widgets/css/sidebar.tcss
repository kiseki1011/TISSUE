Sidebar {
    width: 24;
    height: 1fr;
    layout: vertical;
}

Sidebar.-collapsed {
    width: 2;
}

Sidebar #sidebar_inner {
    width: 1fr;
    height: 100%;
    layout: vertical;
}

Sidebar #sidebar_toggle {
    dock: right;
    width: 2;
    height: 1fr;
    align: center middle;
    background: $primary-darken-2;
}

Sidebar #sidebar_toggle Label {
    width: auto;
    text-align: center;
    color: white;
}

Sidebar #sidebar_toggle:focus Label {
    color: $accent;
    text-style: bold;
}

Sidebar #sidebar_user_slot {
    width: 100%;
    height: 6;
    padding: 0 1;
    border-top: solid $primary-darken-1;
    border-bottom: solid $primary-darken-1;
    background: transparent;
}

Sidebar #sidebar_user_slot:focus {
    background: $primary 20%;
}

Sidebar #sidebar_user_slot .user-top {
    height: 2;
    width: 100%;
}

Sidebar #user_avatar {
    width: 4;
    height: 2;
    margin-right: 1;
}

Sidebar #user_text {
    width: 1fr;
    height: 100%;
}

Sidebar #user_name {
    width: 100%;
    color: $foreground;
    text-style: bold;
}

Sidebar #user_handle {
    width: 100%;
    color: $text-muted;
}

Sidebar #user_email {
    width: 100%;
    height: 1;
    color: $text-muted;
    margin-top: 1;
}

Sidebar #sidebar_items {
    background: transparent;
    border: none;
    height: 1fr;
    padding: 1 1 0 1;
}

Sidebar #sidebar_items > ListItem {
    background: transparent;
    border-top: solid $primary-darken-2;
    height: 2;
    margin-bottom: 1;
    padding: 0;
    border-title-color: $accent;
    border-title-align: right;
}

Sidebar #sidebar_items > ListItem.-highlight {
    background: transparent;
}

Sidebar #sidebar_items:focus > ListItem.-highlight {
    background: $accent 60%;
    color: $foreground;
    text-style: bold;
}

Sidebar #sidebar_logout {
    dock: bottom;
    width: 100%;
    height: 2;
    padding: 0 1;
    margin: 0 1 1 1;
    border: none;
    border-top: solid $error;
    color: $error;
    background: transparent;
    border-title-color: $error;
    border-title-align: right;
}

Sidebar #sidebar_logout:hover {
    background: $error 20%;
}

Sidebar #sidebar_logout:focus {
    border: none;
    border-top: solid $accent;
    color: $accent;
    border-title-color: $accent;
    text-style: bold;
}

Sidebar.-collapsed #sidebar_user_slot,
Sidebar.-collapsed #sidebar_items,
Sidebar.-collapsed #sidebar_logout {
    display: none;
}
