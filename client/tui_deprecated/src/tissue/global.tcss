Screen {
    background: $surface;
    align: center middle;
}

#dialog, #login-dialog, #signup-dialog {
    background: $surface;
    border: round $primary;
    padding: 0 2;
    content-align: center middle;
}

.title {
    text-align: center;
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
    width: 100%;
}

.subtitle {
    text-align: center;
    color: $text-muted;
    margin-bottom: 2;
    width: 100%;
}

Input {
    margin-bottom: 1;
    border: round $primary;
    background: transparent;
}

Input:focus {
    border: round $accent;
    background: transparent;
}

Input > .input--placeholder {
    text-style: italic;
}

Button {
    width: 100%;
    margin: 1 0;
    background: transparent;
}

Button:focus {
    background: transparent;
    background-tint: transparent 0%;
}

ListView {
    background: transparent;
}

ListView:focus {
    background: transparent;
}

.input-field.error {
    border: round $error;
}

.input-field.success {
    border: round $success;
}

Label.error {
    color: $error;
    text-style: italic;
    margin-bottom: 1;
}

Label.success {
    color: $success;
    text-style: bold;
    margin-bottom: 1;
}

.logo {
    text-align: left;
    color: $foreground;
    margin-top: 3;
    margin-bottom: 1;
    width: 100%;
    height: auto;
    content-align: center middle;
}
