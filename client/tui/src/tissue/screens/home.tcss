HomeScreen {
    background: $background;
}

#home-tabs {
    height: 1fr;
}

/* TabPane default height is auto, which collapses 100%-height children to 0.
 * Force tab content to fill the available area so master-detail renders. */
HomeScreen TabPane {
    height: 1fr;
}

.master-detail {
    width: 100%;
    height: 100%;
    padding: 1;
}

.master-table {
    width: 1fr;
    height: 100%;
    margin-right: 1;
}

.detail-pane {
    width: 1fr;
    height: 100%;
    padding: 1 2;
    overflow-y: auto;
}

.detail-row {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

.detail-key {
    width: 28;
    color: $text-muted;
    text-style: bold;
}

.detail-value {
    width: 1fr;
}

.detail-empty {
    color: $text-muted;
    text-style: italic;
    width: 100%;
    text-align: center;
    padding: 2 0;
}

.placeholder {
    color: $text-muted;
    text-style: italic;
    width: 100%;
    text-align: center;
    padding: 4 0;
}
