HomeScreen {
    background: $background;
}

#home-tabs {
    height: 1fr;
}

HomeScreen TabPane {
    height: 1fr;
}

.detail-row {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

.detail-key {
    width: 28;
    color: $text-muted;
    text-style: bold;
}

.detail-value {
    width: 1fr;
}

.detail-empty {
    color: $text-muted;
    text-style: italic;
    width: 100%;
    text-align: center;
    padding: 2 0;
}

.placeholder {
    color: $text-muted;
    text-style: italic;
    width: 100%;
    text-align: center;
    padding: 4 0;
}
