HomeScreen {
    background: $background;
}

#home-tabs {
    height: 1fr;
}

HomeScreen TabPane {
    height: 1fr;
}

/* Toolbar above a tab's TableDetailSplitView.
 * 1fr/1fr mirrors the TableDetailSplitView underneath so the button can
 * sit at the top-right of the table pane. */
.tab-toolbar {
    width: 100%;
    height: 1;
    margin-top: 1;

    .tab-toolbar-table-area {
        width: 1fr;
        height: 1;
        align-horizontal: right;
        margin-right: 1;
    }

    .tab-toolbar-detail-area {
        width: 1fr;
        height: 1;
    }
}

HomeScreen TableDetailSplitView {
    height: 1fr;
}

.invitation-actions {
    width: 100%;
    height: auto;
    align-horizontal: right;
    padding: 0 0;

    Button {
        margin-left: 1;
    }
}

#inv_accept_btn, #inv_reject_btn {
    background: transparent;
}
#inv_accept_btn:hover, #inv_reject_btn:hover {
    background: $surface-lighten-1;
}
#inv_accept_btn:focus, #inv_reject_btn:focus {
    background: transparent !important;
}


.detail-row {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

.detail-key {
    width: 28;
    color: $text-muted;
    text-style: bold;
}

.detail-value {
    width: 1fr;
}

.detail-empty {
    color: $text-muted;
    text-style: italic;
    width: 100%;
    text-align: center;
    padding: 2 0;
}
