IssueFilterModal {
    align: center middle;
    background: $background 60%;
}

IssueFilterModal #filter-dialog {
    width: 56;
    max-width: 90%;
    height: 41;
    max-height: 90%;
    /* No horizontal padding: the scroll spans the full width so its scrollbar sits
       flush at the modal edge. The inner #filter-body + #filter-buttons carry the
       (equal) left/right padding instead. */
    padding: 1 0;
    layout: vertical;
    border-title-align: center;
    border-title-color: $accent;
    border-subtitle-align: center;
    border-subtitle-color: $text-muted;
}

IssueFilterModal #filter-scroll {
    width: 100%;
    height: 1fr;
}

/* Carries the content's horizontal padding (kept equal to #filter-buttons), so the
   scrollbar — which rides the scroll's edge, outside this padding — stays flush. */
IssueFilterModal #filter-body {
    width: 100%;
    height: auto;
    padding: 0 2;
}

/* Section heading above each control group. */
IssueFilterModal .filter-label {
    width: 100%;
    text-style: bold;
    color: $text-muted;
    margin-top: 1;
}

/* A one-line clarifying note under a section heading (e.g. which view it scopes). */
IssueFilterModal .filter-hint {
    width: 100%;
    color: $text-muted;
    text-style: italic;
}

IssueFilterModal #filter-review-status {
    width: 100%;
    height: 3;
    border: none;
    background: $panel;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

/* Heights match the option counts (4 states, 5 priorities) so neither list scrolls
   internally — the whole filter fits the dialog without a nested scrollbar. */
IssueFilterModal #filter-state {
    width: 100%;
    height: 4;
    border: none;
    background: $panel;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

IssueFilterModal #filter-priority {
    width: 100%;
    height: 5;
    border: none;
    background: $panel;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

/* Assignee/sprint are multi-select lists; bounded so a long roster scrolls
   internally rather than growing the dialog. Assignee has a search box above it. */
IssueFilterModal #filter-assignee-search {
    width: 100%;
}

IssueFilterModal #filter-assignee {
    width: 100%;
    height: 5;
    border: none;
    background: $panel;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

IssueFilterModal #filter-sprint {
    width: 100%;
    height: 4;
    border: none;
    background: $panel;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

IssueFilterModal #filter-agent {
    width: 100%;
    margin-top: 1;
    border: none;
    background: transparent;
}

IssueFilterModal #filter-buttons {
    width: 100%;
    height: auto;
    align-horizontal: right;
    margin-top: 1;
    /* Match #filter-body's horizontal padding so the buttons line up with the
       content and the modal's left/right margins read as equal. */
    padding: 0 2;
}

IssueFilterModal #filter-buttons Button {
    margin-left: 1;
    min-width: 11;
}
