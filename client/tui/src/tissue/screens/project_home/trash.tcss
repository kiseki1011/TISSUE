/* Trash mirrors the hub: a toolbar on top, then a 4:3 list/detail grid. */
TrashScreen #trash-body {
    layout: vertical;
    padding: 1 2;
}
/* Same column template as #trash-grid so the toolbar's first column lines up with
   [1]; the checkbox right-aligns inside it and the second column (over [2]) stays
   empty, keeping the [1]/[2] box tops aligned. */
TrashScreen #trash-toolbar {
    width: 100%;
    height: auto;
    layout: grid;
    grid-size: 2 1;
    grid-columns: 4fr 3fr;
    grid-gutter: 1;
}
/* CTRL+F expands [1] to full width: collapse the toolbar the same way so "Mine
   only" follows [1]'s right edge. */
TrashScreen.-trash-expanded #trash-toolbar {
    grid-size: 1 1;
    grid-columns: 1fr;
    grid-gutter: 0;
}
TrashScreen #trash-toolbar-list {
    width: 100%;
    height: auto;
    align-horizontal: right;
}
/* Borderless toggle, matching the issue filter modal's Sprint checkbox, so it
   reads as a plain checkbox rather than a boxed button. */
TrashScreen #trash-mine {
    margin-left: 0;
    width: auto;
    height: auto;
    border: none;
    background: transparent;
}
TrashScreen #trash-grid {
    width: 100%;
    height: 1fr;
    layout: grid;
    grid-size: 2 1;
    grid-columns: 4fr 3fr;
    grid-rows: 1fr;
    grid-gutter: 1;
}
/* CTRL+F closes [2]: [1] takes the full width, Enter then opens the read modal. */
TrashScreen.-trash-expanded #trash-grid {
    grid-size: 1 1;
    grid-columns: 1fr;
    grid-gutter: 0;
}
TrashScreen.-trash-expanded #trash-detail-box {
    display: none;
}
TrashScreen .trash-box {
    width: 100%;
    height: 100%;
    border: round $primary;
    border-title-color: $primary;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
    padding: 0 1;
}
/* No left padding so the # column sits flush at the border, like the hub. */
TrashScreen #trash-list-box {
    padding: 0 1 0 0;
}
TrashScreen #trash-list-box:focus-within,
TrashScreen #trash-detail-box:focus-within {
    border: round $accent;
    border-title-color: $accent;
}
/* Detail box stacks a scrollable body over a pinned action row so Restore stays
   bottom-right regardless of how far the body is scrolled. */
TrashScreen #trash-detail-box {
    layout: vertical;
}
TrashScreen #trash-detail-scroll {
    width: 100%;
    height: 1fr;
    scrollbar-gutter: stable;
    padding: 1 2;
}
TrashScreen #trash-detail-actions {
    width: 100%;
    height: auto;
    align-horizontal: right;
    padding: 0 1 1 0;
}
TrashScreen .trash-restore-btn {
    width: auto;
    min-width: 0;
    padding: 0 1;
    background: transparent;
}
TrashScreen .hub-table {
    height: 1fr;
    border: none;
}
TrashScreen .trash-empty,
TrashScreen .trash-muted {
    width: 100%;
    height: auto;
    color: $text-muted;
    padding: 1;
}
TrashScreen .trash-empty {
    padding: 1 1 1 2;
}
TrashScreen .trash-title {
    width: 100%;
    text-style: bold;
    color: $text;
    padding-bottom: 1;
}
/* Description heading + its rendered markdown body, matching the hub detail. */
TrashScreen .trash-section-title {
    width: 100%;
    text-style: bold;
    color: $text;
    padding-top: 1;
}
TrashScreen .trash-content {
    width: 100%;
    height: auto;
    padding: 0;
}
/* key:value rows, matching the hub detail pane. */
TrashScreen .detail-row {
    width: 100%;
    height: auto;
}
TrashScreen .detail-key {
    width: 15;
    color: $text-muted;
}
TrashScreen .detail-value {
    width: 1fr;
    color: $text;
}
