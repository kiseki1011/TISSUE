/* Trash mirrors the hub: a toolbar on top, then a 4:3 list/detail grid. */
TrashScreen #trash-body {
    layout: vertical;
    padding: 1 2;
}
TrashScreen #trash-toolbar {
    width: 100%;
    height: auto;
}
TrashScreen #trash-toolbar Button {
    margin-right: 1;
}
TrashScreen #trash-grid {
    width: 100%;
    height: 1fr;
    layout: grid;
    grid-size: 2 1;
    grid-columns: 4fr 3fr;
    grid-rows: 1fr;
    grid-gutter: 1;
    margin-top: 1;
}
TrashScreen .trash-box {
    width: 100%;
    height: 100%;
    border: round $primary;
    border-title-color: $primary;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
    padding: 0 1;
}
TrashScreen #trash-list-box {
    padding: 0 1 0 0;
}
TrashScreen #trash-list-box:focus-within,
TrashScreen #trash-detail-box:focus-within {
    border: round $accent;
    border-title-color: $accent;
}
TrashScreen #trash-detail-box {
    scrollbar-gutter: stable;
    padding: 1 2;
}
TrashScreen .hub-table {
    height: 1fr;
    border: none;
}
TrashScreen .trash-empty,
TrashScreen .trash-muted {
    width: 100%;
    height: auto;
    color: $text-muted;
    padding: 1;
}
TrashScreen .trash-title {
    width: 100%;
    text-style: bold;
    color: $text;
    padding-bottom: 1;
}
TrashScreen .trash-row {
    width: 100%;
    height: auto;
}
TrashScreen .trash-key {
    width: 12;
    color: $text-muted;
}
TrashScreen .trash-value {
    width: 1fr;
    color: $text;
}
TrashScreen #trash-actions {
    width: 100%;
    height: auto;
    align-horizontal: right;
    margin-top: 1;
}
