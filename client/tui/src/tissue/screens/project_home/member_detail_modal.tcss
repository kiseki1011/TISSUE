MemberDetailModal {
    align: center middle;
}

MemberDetailModal #mdm-dialog {
    width: 60;
    max-width: 90%;
    height: auto;
    max-height: 90%;
    padding: 1 0;
    layout: vertical;
    border-title-color: $primary;
    border-title-style: bold;
}

MemberDetailModal #mdm-scroll {
    width: 100%;
    height: auto;
    max-height: 100%;
    scrollbar-gutter: stable;
}

MemberDetailModal #mdm-body {
    width: 100%;
    height: auto;
    padding: 0 3;
}

MemberDetailModal .mdm-title {
    width: 1fr;
    text-style: bold;
    color: $text;
}
MemberDetailModal .mdm-spacer {
    width: 100%;
    height: 1;
}

/* key:value rows (shared detail_row widget). */
MemberDetailModal .detail-row {
    width: 100%;
    height: auto;
}
MemberDetailModal .detail-key {
    width: 14;
    color: $text-muted;
}
MemberDetailModal .detail-value {
    width: 1fr;
    color: $text;
}
