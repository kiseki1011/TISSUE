TransitionPickerModal {
    align: center middle;
}
TransitionPickerModal #tr-dialog {
    width: 64;
    height: auto;
    max-height: 80%;
    padding: 1 2;
}
TransitionPickerModal #tr-radio {
    width: 100%;
    height: auto;
    max-height: 16;
    margin-bottom: 1;
}

TransitionPickerModal .tr-blocked {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}
TransitionPickerModal .tr-blocked-title {
    width: 100%;
    color: $warning;
    text-style: bold;
    padding-left: 1;
}
TransitionPickerModal .tr-blocked-reason {
    width: 100%;
    color: $warning;
    padding-left: 2;
}

TransitionPickerModal .tr-actions {
    width: 100%;
    height: auto;
    align-horizontal: right;
}
/* Size each button to its label (no uniform min-width). */
TransitionPickerModal .tr-actions Button {
    width: auto;
    min-width: 0;
    padding: 0 1;
    margin-left: 1;
}
