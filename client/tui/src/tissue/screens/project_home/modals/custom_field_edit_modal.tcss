CustomFieldEditModal {
    align: center middle;
}
/* Default dialog. Per-type widths/heights below size each editor to its content
   such as a tall TextArea, a wide calendar, or a scrolling checklist. */
CustomFieldEditModal #cfe-dialog {
    width: 80;
    max-width: 90%;
    height: auto;
    padding: 1 2;
}
CustomFieldEditModal #cfe-dialog.-date,
CustomFieldEditModal #cfe-dialog.-datetime { width: 85; }
CustomFieldEditModal #cfe-dialog.-pct { width: 60; }
CustomFieldEditModal #cfe-dialog.-select { width: 60; }
CustomFieldEditModal #cfe-dialog.-shorttext { width: 70; }
CustomFieldEditModal #cfe-dialog.-bool { width: 40; }

/* While a calendar overlay is open, grow the dialog so the overlay stays inside
   the box, and dock the buttons below it at the bottom. */
CustomFieldEditModal #cfe-dialog.-date.-expanded,
CustomFieldEditModal #cfe-dialog.-datetime.-expanded {
    height: 28;
}
CustomFieldEditModal #cfe-dialog.-date.-expanded .cfe-actions,
CustomFieldEditModal #cfe-dialog.-datetime.-expanded .cfe-actions {
    dock: bottom;
}

CustomFieldEditModal #cfe-input,
CustomFieldEditModal #cfe-select,
CustomFieldEditModal #cfe-date,
CustomFieldEditModal #cfe-datetime,
CustomFieldEditModal #cfe-bar,
CustomFieldEditModal #cfe-switch {
    width: 100%;
    margin-bottom: 1;
}
/* A multi-line text body and a checklist both want room but cap + scroll. */
CustomFieldEditModal #cfe-text {
    width: 100%;
    height: 12;
    margin-bottom: 1;
}
CustomFieldEditModal #cfe-checklist {
    width: 100%;
    height: auto;
    max-height: 14;
    margin-bottom: 1;
}
CustomFieldEditModal #cfe-status {
    width: 100%;
    height: auto;
    color: $error;
    margin-bottom: 1;
}
CustomFieldEditModal .cfe-actions {
    width: 100%;
    height: auto;
    align-horizontal: right;
}
/* Size each button to its label, so no uniform min-width. */
CustomFieldEditModal .cfe-actions Button {
    width: auto;
    min-width: 0;
    padding: 0 1;
    margin-left: 1;
}
