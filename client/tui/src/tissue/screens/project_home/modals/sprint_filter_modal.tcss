SprintFilterModal {
    align: center middle;
}
SprintFilterModal #sfm-dialog {
    width: 44;
    max-width: 90%;
    height: auto;
    padding: 1 2;
}
SprintFilterModal .sfm-label {
    width: 100%;
    text-style: bold;
    color: $text-muted;
    padding-bottom: 1;
}
SprintFilterModal #sfm-status {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}
SprintFilterModal #sfm-buttons {
    width: 100%;
    height: auto;
    align-horizontal: right;
}
SprintFilterModal #sfm-buttons Button {
    width: auto;
    min-width: 0;
    padding: 0 1;
    margin-left: 1;
}
