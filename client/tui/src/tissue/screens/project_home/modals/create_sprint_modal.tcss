CreateSprintModal {
    align: center middle;
}

CreateSprintModal #csm-dialog {
    width: 70;
    max-width: 90%;
    height: auto;
    max-height: 90%;
    padding: 2 0 1 0;
    layout: vertical;
}

CreateSprintModal #csm-form {
    width: 100%;
    height: auto;
    padding: 0 5;
}

/* Field name lives in each control's border title. */
CreateSprintModal Input,
CreateSprintModal TextArea {
    border-title-color: $primary;
    border-title-style: bold;
}

CreateSprintModal #csm-title {
    width: 100%;
    margin-bottom: 1;
}

CreateSprintModal #csm-goal {
    width: 100%;
    height: 6;
    margin-bottom: 1;
}

CreateSprintModal #csm-status {
    width: 100%;
    height: auto;
    color: $error;
    padding: 0 5;
    margin-top: 1;
}

CreateSprintModal #csm-actions {
    width: 100%;
    height: auto;
    align-horizontal: right;
    padding: 0 5;
    margin-top: 1;
}
CreateSprintModal #csm-actions Button {
    width: auto;
    min-width: 0;
    padding: 0 1;
    margin-left: 1;
}
