EditSprintModal {
    align: center middle;
}

EditSprintModal #esm-dialog {
    width: 83;
    max-width: 90%;
    height: auto;
    max-height: 90%;
    padding: 2 0 1 0;
    layout: vertical;
}

EditSprintModal #esm-scroll {
    width: 100%;
    height: auto;
    max-height: 28;
    scrollbar-gutter: stable;
}
EditSprintModal #esm-form {
    width: 100%;
    height: auto;
    padding: 0 5;
}

EditSprintModal Input,
EditSprintModal TextArea,
EditSprintModal #esm-due {
    border-title-color: $primary;
    border-title-style: bold;
}

EditSprintModal #esm-due {
    border: solid $primary;
    height: 3;
}
EditSprintModal #esm-due:focus-within {
    border: solid $accent;
    border-title-color: $accent;
}
EditSprintModal #esm-due > #input-control {
    border: none;
    height: 1;
    padding: 0;
}

EditSprintModal #esm-title,
EditSprintModal #esm-due {
    width: 100%;
    margin-bottom: 1;
}

EditSprintModal #esm-goal {
    width: 100%;
    height: 8;
    margin-bottom: 1;
}

EditSprintModal #esm-status {
    width: 100%;
    height: auto;
    color: $error;
    padding: 0 5;
    margin-top: 1;
}

EditSprintModal #esm-actions {
    width: 100%;
    height: auto;
    align-horizontal: right;
    padding: 0 5;
    margin-top: 1;
}
EditSprintModal #esm-actions Button {
    width: auto;
    min-width: 0;
    padding: 0 1;
    margin-left: 1;
}
