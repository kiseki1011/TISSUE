ReviewerPickerModal {
    align: center middle;
    background: $background 60%;
}

ReviewerPickerModal #reviewer-dialog {
    width: 52;
    max-width: 90%;
    height: 24;
    max-height: 90%;
    padding: 1 2;
    layout: vertical;
    border-title-align: center;
    border-title-color: $accent;
    border-subtitle-align: center;
    border-subtitle-color: $text-muted;
}

ReviewerPickerModal #reviewer-search {
    width: 100%;
}

ReviewerPickerModal #reviewer-list {
    width: 100%;
    height: 1fr;
    margin-top: 1;
    border: none;
    background: $panel;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

ReviewerPickerModal .reviewer-count {
    width: 100%;
    color: $text-muted;
    margin-top: 1;
}

ReviewerPickerModal .reviewer-count.-over-limit {
    color: $error;
    text-style: bold;
}

ReviewerPickerModal #reviewer-buttons {
    width: 100%;
    height: auto;
    align-horizontal: right;
    margin-top: 1;
}

ReviewerPickerModal #reviewer-buttons Button {
    margin-left: 1;
    min-width: 11;
}
