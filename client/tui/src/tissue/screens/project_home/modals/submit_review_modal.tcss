SubmitReviewModal {
    align: center middle;
    background: $background 60%;
}

SubmitReviewModal #srm-dialog {
    width: 56;
    max-width: 90%;
    height: auto;
    padding: 1 2;
    layout: vertical;
    border-title-align: center;
    border-title-color: $accent;
    border-subtitle-align: center;
    border-subtitle-color: $text-muted;
}

SubmitReviewModal .srm-prompt {
    width: 100%;
    height: auto;
    color: $text;
    margin-bottom: 1;
}

SubmitReviewModal #srm-buttons {
    width: 100%;
    height: auto;
    align-horizontal: right;
}

SubmitReviewModal #srm-buttons Button {
    margin-left: 1;
    min-width: 11;
}
