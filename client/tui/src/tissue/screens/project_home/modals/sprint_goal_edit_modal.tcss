SprintGoalEditModal {
    align: center middle;
}
SprintGoalEditModal #sge-dialog {
    width: 80;
    max-width: 90%;
    height: auto;
    padding: 1 2;
}
SprintGoalEditModal #sge-editor {
    width: 100%;
    height: 12;
    margin-bottom: 1;
}
SprintGoalEditModal #sge-status {
    width: 100%;
    height: auto;
    color: $error;
    margin-bottom: 1;
}
SprintGoalEditModal #sge-actions {
    width: 100%;
    height: auto;
    align-horizontal: right;
}
SprintGoalEditModal #sge-actions Button {
    width: auto;
    min-width: 0;
    padding: 0 1;
    margin-left: 1;
}
