IssueFilterModal {
    align: center middle;
    background: $background 60%;
}

IssueFilterModal #filter-dialog {
    width: 58;
    max-width: 90%;
    /* Tall enough that the [1] and [3] filter groups both show without scrolling on
       a normal terminal. max-height caps it on short ones, where the body scrolls. */
    height: 46;
    max-height: 90%;
    /* No horizontal padding so the scroll spans the full width and its scrollbar sits
       flush at the modal edge. The inner #filter-body and #filter-buttons carry the
       equal left/right padding instead. */
    padding: 1 0;
    layout: vertical;
    border-title-align: center;
    border-title-color: $accent;
    border-subtitle-align: center;
    border-subtitle-color: $text-muted;
}

IssueFilterModal #filter-scroll {
    width: 100%;
    height: 1fr;
}

/* Carries the content's horizontal padding, kept equal to #filter-buttons, so the
   scrollbar stays flush. The scrollbar rides the scroll's edge, outside this padding. */
IssueFilterModal #filter-body {
    width: 100%;
    height: auto;
    padding: 0 3;
}

/* Section heading above each control group. */
IssueFilterModal .filter-label {
    width: 100%;
    text-style: bold;
    color: $text-muted;
    margin-top: 1;
}

/* Group header splitting the [1] Issues filters from the [3] filters. Bolder and
   accented versus the per-field .filter-label. */
IssueFilterModal .filter-group {
    width: 100%;
    text-style: bold;
    color: $accent;
    margin-top: 1;
}
/* The divider between the [1] and [3] filter groups. */
IssueFilterModal Rule {
    margin: 1 0 0 0;
}

IssueFilterModal #filter-review-status {
    width: 100%;
    height: 3;
    border: none;
    background: $panel;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

/* Heights match the option counts (4 states, 5 priorities) so neither list scrolls
   internally, letting the whole filter fit the dialog without a nested scrollbar. */
IssueFilterModal #filter-state {
    width: 100%;
    height: 4;
    border: none;
    background: $panel;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

IssueFilterModal #filter-priority {
    width: 100%;
    height: 5;
    border: none;
    background: $panel;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

/* Assignee and sprint are multi-select lists, bounded so a long roster scrolls
   internally rather than growing the dialog. Assignee has a search box above it. */
IssueFilterModal #filter-assignee-search {
    width: 100%;
}

IssueFilterModal #filter-assignee {
    width: 100%;
    height: 5;
    border: none;
    background: $panel;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

/* A borderless checkbox, matching #filter-agent, so it reads as a plain toggle
   rather than a boxed control. The top margin sets it off from the Sprint label. */
IssueFilterModal #filter-current-sprint {
    width: 100%;
    margin-top: 1;
    border: none;
    background: transparent;
}

IssueFilterModal #filter-agent {
    width: 100%;
    margin-top: 1;
    border: none;
    background: transparent;
}

IssueFilterModal #filter-buttons {
    width: 100%;
    height: auto;
    align-horizontal: right;
    margin-top: 1;
    /* Match #filter-body's horizontal padding so the buttons line up with the
       content and the modal's left/right margins read as equal. */
    padding: 0 3;
}

IssueFilterModal #filter-buttons Button {
    margin-left: 1;
    min-width: 11;
}
