RelationAddModal {
    align: center middle;
    background: $background 60%;
}

RelationAddModal #rel-dialog {
    width: 64;
    max-width: 90%;
    height: 26;
    max-height: 90%;
    padding: 1 2;
    layout: vertical;
    border-title-align: center;
    border-title-color: $accent;
    border-subtitle-align: center;
    border-subtitle-color: $text-muted;
}

RelationAddModal #rel-type {
    width: 100%;
    margin-bottom: 1;
}

RelationAddModal #rel-search {
    width: 100%;
}

RelationAddModal #rel-list {
    width: 100%;
    height: 1fr;
    margin-top: 1;
    border: none;
    background: $panel;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}
