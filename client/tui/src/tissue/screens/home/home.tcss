/* Search bar on top, the dashboard grid fills the rest. */
HomeScreen #screen-body {
    layout: vertical;
}
HomeScreen #dashboard-search-row {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}
HomeScreen #dashboard-search {
    width: 1fr;
    border-title-color: $primary;
    border-title-style: bold;
}

/* 2x3 grid. Uniform grid-gutter keeps column heights aligned across terminals.

   Columns:
       - Left: [1] Searched (1 row), then [2] My Work (row-span 2)
       - Right: Details (row-span 2), then [3] Projects under it */
HomeScreen #dashboard-grid {
    width: 100%;
    height: 1fr;
    layout: grid;
    grid-size: 2 3;
    grid-rows: 1fr 1fr 1fr;
    grid-columns: 1fr 1fr;
    grid-gutter: 1;
}

/* Shared box chrome, border plus a title that sits on the top border. Each box
   fills its grid cell. */
HomeScreen .dashboard-box {
    width: 100%;
    height: 100%;
    padding: 0 1;
    border-title-color: $primary;
    border-title-style: bold;
}

/* Accent the box border when it (or its table) has focus. */
HomeScreen .dashboard-box:focus-within {
    border: solid $accent;
    border-title-color: $accent;
}

/* [2] My Work spans 2 rows on the left, mirroring the Details pane height. */
HomeScreen #dash-mywork {
    row-span: 2;
}

/* Details pane. Row-spans 2 so it lines up with [1]+[2] on the left (gutter
   included) and sits above [3] Projects. The raised surface background sets it
   apart. Its border matches the screen background, so it looks invisible but
   still keeps the footprint aligned with the bordered boxes and lets the
   "Details" border-title render. The inner container carries the padding. */
HomeScreen #dashboard-detail {
    row-span: 2;
    padding: 0;
    background: $surface;
    border: solid $background;
    border-title-color: $primary;
    border-title-style: bold;
}
HomeScreen #dashboard-detail-inner {
    width: 100%;
    height: auto;
    padding: 1 2;
}
HomeScreen #dashboard-detail-inner .dashboard-muted {
    padding: 0;
}

/* Selectable tables fill their box. The box already draws the border and title. */
HomeScreen .dashboard-table {
    height: 1fr;
    border: none;
}

HomeScreen .dashboard-muted {
    width: 100%;
    height: auto;
    color: $text-muted;
    padding: 1;
}

/* Detail pane content, project and issue detail styling. */
HomeScreen .dashboard-detail-title {
    width: 100%;
    text-style: bold;
    color: $text;
    padding-bottom: 1;
}
HomeScreen .dashboard-detail-desc {
    width: 100%;
    padding-top: 1;
    color: $text;
}
/* The issue body, rendered as Markdown. Drop the widget's own horizontal padding
   of 0 2 so it lines up with the detail rows above it. The inner wrapper already
   supplies the horizontal padding. */
HomeScreen .dashboard-content {
    width: 100%;
    height: auto;
    padding: 0;
}
HomeScreen .dashboard-detail-hint {
    width: 100%;
    padding-top: 1;
    color: $text-muted;
    text-style: italic;
}
HomeScreen .detail-row {
    width: 100%;
    height: auto;
}
HomeScreen .detail-key {
    width: 17;
    color: $text-muted;
}
HomeScreen .detail-value {
    width: 1fr;
    color: $text;
}
/* In project detail, make the Key value stand out. */
HomeScreen .dashboard-key-value {
    color: $primary;
    text-style: bold;
}
