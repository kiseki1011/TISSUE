DeprecatedHomeScreen #screen-body {
    padding: 0;
}
DeprecatedHomeScreen TabbedContent {
    height: 1fr;
}
DeprecatedHomeScreen TabPane {
    height: 1fr;
    padding: 0 1;
}

DeprecatedHomeScreen #tabs-list {
    width: 100%;
}
DeprecatedHomeScreen Tab {
    width: 1fr;
}

DeprecatedHomeScreen Button {
    background: transparent;
}
DeprecatedHomeScreen DataTable {
    background: $background;
}

DeprecatedHomeScreen #project-archived-toggle {
    margin-left: 2;
    width: auto;
    background: transparent;
}

DeprecatedHomeScreen .split-detail-actions {
    align-horizontal: right;
}
DeprecatedHomeScreen .split-detail-actions TextButton {
    padding: 0 1;
}
DeprecatedHomeScreen #project-create-btn { background: $success 15%; color: $success; }
DeprecatedHomeScreen #project-create-btn:hover { background: $success 30%; color: $success; }
DeprecatedHomeScreen #project-create-btn:focus { background: $success !important; color: $background; }
DeprecatedHomeScreen #project-pin-btn { background: $secondary 15%; color: $secondary; }
DeprecatedHomeScreen #project-pin-btn:hover { background: $secondary 30%; color: $secondary; }
DeprecatedHomeScreen #project-pin-btn:focus { background: $secondary !important; color: $background; }
DeprecatedHomeScreen #project-archive-btn { background: $warning 15%; color: $warning; }
DeprecatedHomeScreen #project-archive-btn:hover { background: $warning 30%; color: $warning; }
DeprecatedHomeScreen #project-archive-btn:focus { background: $warning !important; color: $background; }
DeprecatedHomeScreen .project-status {
    width: 100%;
    height: 1fr;
    align: center middle;
    text-align: center;
    padding: 2 4;
}
DeprecatedHomeScreen .status-title {
    width: auto;
    text-style: bold;
    color: $text;
    padding-bottom: 1;
}
DeprecatedHomeScreen .status-sub {
    width: auto;
    color: $text-muted;
    padding-bottom: 2;
}
DeprecatedHomeScreen .status-error {
    width: auto;
    color: $error;
}
DeprecatedHomeScreen #project-main {
    width: 100%;
    height: 1fr;
}
DeprecatedHomeScreen .detail-body {
    width: 100%;
    height: auto;
}
DeprecatedHomeScreen .detail-title {
    width: 100%;
    text-style: bold;
    color: $text;
    padding-bottom: 1;
}
DeprecatedHomeScreen .detail-row {
    width: 100%;
    height: auto;
}
DeprecatedHomeScreen .detail-key {
    width: 14;
    color: $text-muted;
}
DeprecatedHomeScreen .detail-value {
    width: 1fr;
    color: $text;
}
DeprecatedHomeScreen .detail-desc {
    width: 100%;
    padding-top: 1;
    color: $text;
}
DeprecatedHomeScreen .detail-hint {
    width: 100%;
    padding-top: 1;
    color: $text-muted;
    text-style: italic;
}
DeprecatedHomeScreen .detail-empty {
    width: 100%;
    color: $text-muted;
}
/* wiki tab */
DeprecatedHomeScreen #wiki-body {
    width: 100%;
    height: 1fr;
}
DeprecatedHomeScreen #wiki-main {
    width: 1fr;
    height: 1fr;
}

DeprecatedHomeScreen #wiki-content {
    width: 1fr;
    height: 1fr;
    margin: 1 2 0 2;
    padding: 0;
    /* Always reserve the scrollbar's space so content doesn't shift left when a
       scrollbar appears (switching between short and long documents). */
    scrollbar-gutter: stable;
    border-title-align: left;
}

DeprecatedHomeScreen #wiki-content-inner {
    width: 1fr;
    height: auto;
    padding: 1 2;
}
DeprecatedHomeScreen #wiki-results {
    width: 100%;
    height: auto;
}
DeprecatedHomeScreen .wiki-doc-title {
    width: 1fr;
    text-style: bold;
    color: $text;
    padding-bottom: 1;
}
/* title/parent on the left, version picker + edit/lock on the top-right */
DeprecatedHomeScreen .wiki-doc-header {
    width: 1fr;
    height: auto;
}
DeprecatedHomeScreen .wiki-header-left {
    width: 1fr;
    height: auto;
}
DeprecatedHomeScreen .wiki-header-right {
    width: auto;
    height: auto;
    align-horizontal: right;
}
DeprecatedHomeScreen #wiki-version-select {
    width: 28;
}

/* edit/lock button */
DeprecatedHomeScreen .wiki-header-buttons {
    width: 100%;
    height: auto;
    margin-top: 1;
    padding-left: 1;

    TextButton {
        padding: 0 1;
        margin-right: 2;
    }
}

DeprecatedHomeScreen .wiki-header-left .detail-key {
    width: 9;
}

DeprecatedHomeScreen .wiki-parent-link {
    color: $accent;
    text-style: underline;
}
DeprecatedHomeScreen .wiki-parent-link:hover {
    color: $accent-lighten-1;
    text-style: bold underline;
}
/* draw divider above the document body */
DeprecatedHomeScreen .wiki-divider {
    color: $primary;
    margin: 1 0 1 0;
}
DeprecatedHomeScreen #wiki-edit-btn { background: $primary 15%; color: $primary; }
DeprecatedHomeScreen #wiki-edit-btn:hover { background: $primary 30%; color: $primary; }
DeprecatedHomeScreen #wiki-edit-btn:focus { background: $primary !important; color: $background; }
DeprecatedHomeScreen #wiki-lock-btn { background: $secondary 15%; color: $secondary; }
DeprecatedHomeScreen #wiki-lock-btn:hover { background: $secondary 30%; color: $secondary; }
DeprecatedHomeScreen #wiki-lock-btn:focus { background: $secondary !important; color: $background; }
DeprecatedHomeScreen .wiki-version-banner {
    width: 100%;
    padding: 0 1;
    margin-bottom: 1;
    color: $warning;
    text-style: italic;
}
DeprecatedHomeScreen #wiki-doc-body {
    width: 100%;
    height: auto;
}
DeprecatedHomeScreen .wiki-search-header {
    width: 100%;
    color: $text-muted;
    padding-bottom: 1;
}
DeprecatedHomeScreen .wiki-muted {
    width: 100%;
    color: $text-muted;
    padding: 1 0;
}
