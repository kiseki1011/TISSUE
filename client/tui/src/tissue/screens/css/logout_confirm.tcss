LogoutConfirmModal {
    align: center middle;
    background: $background 60%;
}

#logout-confirm-dialog {
    width: auto;
    min-width: 44;
    max-width: 64;
    height: auto;
    background: $surface;
    border: round $primary;
    border-title-align: center;
    border-title-color: $accent;
    padding: 1 2;
}

#logout-confirm-dialog .confirm-message {
    width: 100%;
    text-align: center;
    padding: 1 0;
    margin-bottom: 1;
}

#logout-confirm-dialog .button-row {
    width: 100%;
    height: auto;
    align: center middle;
}

#logout-confirm-dialog .button-row Button {
    width: auto;
    min-width: 12;
    margin: 0 1;
}
