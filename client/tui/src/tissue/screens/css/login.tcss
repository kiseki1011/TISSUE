#login-container {
    height: auto;
    align: center middle;
}

#header_row {
    width: 100%;
    height: 1;
    align: left middle;
    margin-bottom: 0;
    padding-left: 1;
}

#back_btn {
    width: 3;
    height: 1;
    min-width: 3;
    padding: 0;
    margin: 0;
    border: none;
}

.input-field {
    width: 100%;
}

#btn-row {
    margin-top: 2;
    height: 3;
    width: 100%;
    align: center middle;
}

#login_btn, #signup_btn {
    width: 1fr;
    height: 3;
    margin: 0 1;
}

#signup_notice {
    margin-top: 2;
    color: $warning;
    text-align: center;
    width: 100%;
}
