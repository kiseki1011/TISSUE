#dialog {
    layers: base overlay;
}

.centered-row {
    width: 100%;
    height: auto;
    align: center middle;
}

#back_btn {
    layer: overlay;
    offset: 2 0;
    width: 3;
    height: 1;
    min-width: 0;
    border: none;
    padding: 0;
    margin: 0;
    margin-top: 1;
    background: $primary;
    background-tint: transparent 0%;
    color: $surface;
}

#back_btn:focus {
    background: $accent;
    background-tint: transparent 0%;
    color: $surface;
    text-style: bold;
}

.input-field {
    width: 73%;
    margin-bottom: 0;
}

.input-field > .input--placeholder {
    text-style: italic;
}

#email_row {
    margin-top: 4;
}

#password_row {
    margin-top: 1;
}

#btn_row_wrapper {
    margin-top: 1;
    height: 3;
}

#btn-row {
    width: 75%;
    height: 3;
}

#login_btn, #signup_btn {
    width: 1fr;
    height: 3;
    margin: 0 1;
    background: transparent;
    background-tint: transparent 0%;
}

#login_btn {
    border: round $primary;
    color: $primary;
}

#login_btn:focus {
    border: round $accent;
    color: $accent;
    text-style: bold;
}

#signup_btn {
    border: round $success;
    color: $success;
}

#signup_btn:focus {
    border: round $accent;
    color: $accent;
    text-style: bold;
}

#signup_notice {
    margin-top: 2;
    color: $warning;
    text-align: center;
    width: 100%;
}
