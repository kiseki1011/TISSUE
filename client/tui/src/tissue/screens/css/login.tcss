#login-dialog {
    layers: base overlay;
    max-width: 53;
    height: 41;
    padding: 1 4 1 4;
    padding-bottom: 2;
}

#login-dialog.-auto {
    height: auto;
}

#login-dialog.-compact {
    height: 19;
    padding: 1 4 1 4;
}

#login-dialog #back_btn {
    layer: overlay;
    offset: 0 0;
    margin-top: 0;
}

#login-dialog .logo {
    margin-top: 3;
    margin-bottom: 3;
}

#login-dialog .subtitle {
    margin-bottom: 3;
}

#login-dialog .input-field {
    width: 100%;
    margin-bottom: 0;
}

#login-dialog .status-msg {
    height: 1;
    margin: 0 0 0 0;
    padding-left: 1;
    width: 100%;
    text-align: left;
    color: $text-muted;
}

#login-dialog #login_btn,
#login-dialog #signup_btn,
#login-dialog #oauth_btn {
    width: 100%;
    height: 3;
    margin-bottom: 0;
}

#login-dialog .oauth-provider-seperator {
    margin-top: 1;
    margin-bottom: 1;
    color: $primary;
    text-align: center;
    width: 100%;
}

#login-dialog .oauth-row {
    width: 100%;
    height: 3;
    align-horizontal: center;
}

#login-dialog #signup_notice {
    margin-top: 1;
    color: $warning;
    text-align: center;
    width: 100%;
}

#login-dialog.-compact .logo {
    display: none;
}

#login-dialog.-compact .subtitle {
    margin-bottom: 0;
}

#login-dialog.-compact .input-field {
    margin-bottom: 0;
}

#login-dialog.-compact #login_btn,
#login-dialog.-compact #signup_btn,
#login-dialog.-compact #oauth_btn {
    margin-bottom: 0;
}

#login-dialog.-compact #signup_notice {
    margin-top: 0;
}

#login-dialog.-compact .oauth-provider-seperator {
    display: none;
}
