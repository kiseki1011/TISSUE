ProjectListScreen #screen-body {
    padding: 0;
}

ProjectListScreen Button {
    background: transparent;
}
ProjectListScreen DataTable {
    background: $background;
}

ProjectListScreen #project-archived-toggle {
    margin-left: 2;
    width: auto;
    background: transparent;
}

ProjectListScreen .split-detail-actions {
    align-horizontal: right;
}
ProjectListScreen .split-detail-actions TextButton {
    padding: 0 1;
}
ProjectListScreen #project-create-btn { background: $success 15%; color: $success; }
ProjectListScreen #project-create-btn:hover { background: $success 30%; color: $success; }
ProjectListScreen #project-create-btn:focus { background: $success !important; color: $background; }
ProjectListScreen #project-pin-btn { background: $secondary 15%; color: $secondary; }
ProjectListScreen #project-pin-btn:hover { background: $secondary 30%; color: $secondary; }
ProjectListScreen #project-pin-btn:focus { background: $secondary !important; color: $background; }
ProjectListScreen #project-archive-btn { background: $warning 15%; color: $warning; }
ProjectListScreen #project-archive-btn:hover { background: $warning 30%; color: $warning; }
ProjectListScreen #project-archive-btn:focus { background: $warning !important; color: $background; }

ProjectListScreen .project-status {
    width: 100%;
    height: 1fr;
    align: center middle;
    text-align: center;
    padding: 2 4;
}
ProjectListScreen .status-title {
    width: auto;
    text-style: bold;
    color: $text;
    padding-bottom: 1;
}
ProjectListScreen .status-sub {
    width: auto;
    color: $text-muted;
    padding-bottom: 2;
}
ProjectListScreen .status-error {
    width: auto;
    color: $error;
}
ProjectListScreen #project-main {
    width: 100%;
    height: 1fr;
}
ProjectListScreen .detail-body {
    width: 100%;
    height: auto;
}
ProjectListScreen .detail-title {
    width: 100%;
    text-style: bold;
    color: $text;
    padding-bottom: 1;
}
ProjectListScreen .detail-row {
    width: 100%;
    height: auto;
}
ProjectListScreen .detail-key {
    width: 14;
    color: $text-muted;
}
ProjectListScreen .detail-value {
    width: 1fr;
    color: $text;
}
ProjectListScreen .detail-desc {
    width: 100%;
    padding-top: 1;
    color: $text;
}
ProjectListScreen .detail-hint {
    width: 100%;
    padding-top: 1;
    color: $text-muted;
    text-style: italic;
}
ProjectListScreen .detail-empty {
    width: 100%;
    color: $text-muted;
}
