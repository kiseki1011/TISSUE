Screen {
    background: $background;
}

#dialog {
    width: 100%;
    height: 100%;
    align: center middle;
    overflow-y: auto;

    .dialog-subtitle {
        width: 100%;
        text-align: center;
        margin-top: 1;
        margin-bottom: 3;
    }
}

#left-pane, #right-pane {
    width: 78;
    height: auto;
}

.logo {
    color: $foreground;
    width: auto;
    height: auto;
}

#left-pane Center {
    height: 8;
}

#login-form {
    width: 100%;
    height: auto;
    padding: 0 13;

    .input-field {
        width: 100%;
    }

    #login_btn,
    #signup_btn {
        width: 100%;
        height: 3;
    }

    #restore-row {
        width: 100%;
        height: auto;
        align-horizontal: right;
        margin-top: 1;

        /* keep primary color in resting state */
        #restore_link:focus {
            background: transparent !important;
            color: $accent !important;
            text-style: bold;
        }
    }
}

/* width < 78: hide left pane (logo + subtitle) so form centers */
LoginScreen.-h-narrow #left-pane {
    display: none;
}

/* height <= 42 and width > 155: horizontal split (left-pane | right-pane) */
LoginScreen.-v-short.-h-wide #dialog {
    layout: horizontal;
}

LoginScreen.-v-short.-h-wide #dialog #left-pane {
    width: 1fr;
    height: 100%;
    align: center middle;
}

LoginScreen.-v-short.-h-wide #dialog #right-pane {
    width: 1fr;
    height: 100%;
    align: center middle;
    overflow-y: auto;
}

LoginScreen.-v-short.-h-wide #dialog .dialog-subtitle {
    margin-top: 1;
}

LoginScreen.-v-short.-h-wide #login-form {
    width: 78;
    height: auto;
}

/* height <= 42 and width <= 155: hide left pane so form centers */
LoginScreen.-v-short.-h-medium #left-pane {
    display: none;
}

/* OIDC mode: a single centered column, kept identical at every terminal size */
#oidc-dialog {
    width: 100%;
    height: 100%;
    align: center middle;
    overflow: auto;
}

#oidc-card {
    width: 78;
    height: auto;
    align: center middle;
}

#oidc-card .logo {
    width: auto;
    height: auto;
    margin-bottom: 1;
}

#oidc-card .dialog-subtitle {
    margin-bottom: 2;
}

#oidc-card .oidc-action {
    width: 100%;
    height: auto;
    padding: 0 13;
}
