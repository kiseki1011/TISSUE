Screen {
    background: $background;
}

#dialog {
    width: 100%;
    height: 100%;
    align: center middle;
    overflow-y: auto;

    .dialog-subtitle {
        width: 100%;
        text-align: center;
        margin-top: 1;
        margin-bottom: 3;
    }

    #signup_notice {
        margin-top: 1;
        color: $warning;
        text-align: center;
        width: 100%;
    }
}

#left-pane, #right-pane {
    width: 74;
    height: auto;
}

.logo {
    color: $foreground;
    width: auto;
    height: auto;
}

#left-pane Center {
    height: 8;
}

#login-form {
    width: 77;
    height: auto;
    padding: 0 14;

    .input-field {
        width: 100%;
    }

    #login_btn,
    #signup_btn {
        width: 100%;
        height: 3;
    }

    .oauth-separator {
        margin-top: 1;
        margin-bottom: 1;
        color: $primary;
        text-align: center;
        width: 100%;
    }

    .oauth-row {
        width: 100%;
        height: 3;
        align-horizontal: center;
    }
}

/* add margin between login-signup button for hkey border-style */
App.-border-hkey #login-form #login_btn {
    margin-bottom: 1;
}

/* width <= 72: hide left pane (logo + subtitle) so form centers */
LoginScreen.-h-narrow #left-pane {
    display: none;
}

/* height <= 42 and wioth > 155: horizontal split (left-pane | right-pane) */
LoginScreen.-v-short.-h-wide #dialog {
    layout: horizontal;
}

LoginScreen.-v-short.-h-wide #dialog #left-pane {
    width: 1fr;
    height: 100%;
    align: center middle;
}

LoginScreen.-v-short.-h-wide #dialog #right-pane {
    width: 1fr;
    height: 100%;
    align: center middle;
    overflow-y: auto;
}

LoginScreen.-v-short.-h-wide #dialog .dialog-subtitle {
    margin-top: 1;
}

LoginScreen.-v-short.-h-wide #login-form {
    width: 74;
    height: auto;
}

/* height <= 42 and width <= 155: hide left pane so form centers */
LoginScreen.-v-short.-h-medium #left-pane {
    display: none;
}
