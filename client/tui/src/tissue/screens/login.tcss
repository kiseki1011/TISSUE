LoginScreen {
    align: center middle;
}

#login-dialog {
    layers: base overlay;
    max-width: 53;
    height: auto;
    padding: 1 4 2 4;
}

#login-dialog #back_btn {
    layer: overlay;
    offset: 2 0;
}

#login-dialog .logo {
    margin-top: 3;
    margin-bottom: 3;
    width: 100%;
    height: auto;
    content-align: center middle;
}

LoginScreen.-narrow .logo {
    display: none;
}

#login-dialog .dialog-subtitle {
    margin-bottom: 3;
}

#login-form {
    width: 100%;
    height: auto;
    padding: 0 2;
}

#login-form .input-field {
    width: 100%;
}

#login-form #login_btn,
#login-form #signup_btn {
    width: 100%;
    height: 3;
}

/* Add margin between login-signup button for hkey border-style */
App.-border-hkey #login-form #login_btn {
    margin-bottom: 1;
}

#login-form .oauth-separator {
    margin-top: 1;
    margin-bottom: 1;
    color: $primary;
    text-align: center;
    width: 100%;
}

#login-form .oauth-row {
    width: 100%;
    height: 3;
    align-horizontal: center;
}

#login-dialog #signup_notice {
    margin-top: 1;
    color: $warning;
    text-align: center;
    width: 100%;
}
