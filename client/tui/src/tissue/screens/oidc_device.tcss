OidcDeviceModal {
    align: center middle;
}

#oidc-device-dialog {
    width: 64;
    height: auto;
    padding: 1 3;
    background: $surface;

    & > Static {
        width: 100%;
        text-align: center;
    }
}

#oidc-instruction {
    color: $text-muted;
    margin-bottom: 1;
}

#oidc-code {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

#oidc-url {
    color: $primary;
    margin-bottom: 1;
}

#oidc-status {
    color: $text-muted;
    margin-top: 1;
}

#oidc-cancel-hint {
    color: $secondary;
    margin-top: 1;
}
