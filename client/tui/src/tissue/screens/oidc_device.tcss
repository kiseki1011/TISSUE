OidcDeviceModal {
    align: center middle;
}

#oidc-device-dialog {
    width: 64;
    height: auto;
    padding: 1 3;
    background: $surface;
    border-subtitle-align: center;
    border-subtitle-color: $text-muted;

    & > Static {
        width: 100%;
        text-align: center;
    }
}

#oidc-instruction {
    color: $text-muted;
    margin-bottom: 1;
}

#oidc-code-row {
    width: 100%;
    height: 1;
    align: center middle;
    margin-bottom: 1;
}

#oidc-code-row #oidc-code {
    width: auto;
    text-style: bold;
    color: $accent;
}

#oidc-code-row #oidc-copy {
    width: auto;
    margin-left: 1;
    background: transparent;
    color: $accent;
    text-style: bold;
}

#oidc-url {
    color: $primary;
    margin-bottom: 1;
}

#oidc-status {
    color: $text-muted;
    margin-top: 1;
}

#oidc-warning {
    color: $error;
    text-style: bold;
    margin-top: 1;
}

