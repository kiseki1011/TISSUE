ChangePasswordModal {
    align: center middle;
    background: $background 60%;
}

#change-password-dialog {
    width: 64;
    max-width: 90%;
    min-width: 50;
    height: auto;
    min-height: 24;
    max-height: 90%;
    padding: 0;
    border-title-align: center;
    border-title-color: $accent;
    border-subtitle-align: center;
    border-subtitle-color: $text-muted;
    overflow-y: auto;
}

#change-password-form {
    width: 100%;
    height: auto;
    padding: 2 4;

    .input-field {
        width: 100%;
    }

    #change_password_submit_btn {
        width: 100%;
        height: 3;
        margin-top: 1;
    }
}
