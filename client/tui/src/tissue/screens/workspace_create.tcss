WorkspaceCreateModal {
    align: center middle;
    background: $background 60%;
}

#ws-create-dialog {
    width: 72;
    max-width: 90%;
    min-width: 50;
    height: auto;
    min-height: 26;
    max-height: 90%;
    padding: 0;
    border-title-align: center;
    border-title-color: $accent;
    border-subtitle-align: center;
    border-subtitle-color: $text-muted;
    overflow-y: auto;
}

#ws-create-form {
    width: 100%;
    height: auto;
    padding: 2 4;

    .input-field {
        width: 100%;
    }

    .textarea-field {
        width: 100%;
        height: 10;
    }

    #ws_create_btn {
        width: 100%;
        height: 3;
        margin-top: 1;
    }
}
