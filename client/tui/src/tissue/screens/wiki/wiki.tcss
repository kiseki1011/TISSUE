WikiScreen #screen-body {
    padding: 0 1;
}
WikiScreen #wiki-body {
    width: 100%;
    height: 1fr;
}
WikiScreen #wiki-main {
    width: 1fr;
    height: 1fr;
}

WikiScreen #wiki-content {
    width: 1fr;
    height: 1fr;
    margin: 1 2 0 2;
    padding: 0;
    /* Always reserve the scrollbar's space so content doesn't shift left when a
       scrollbar appears (switching between short and long documents). */
    scrollbar-gutter: stable;
    border-title-align: left;
}

WikiScreen #wiki-content-inner {
    width: 1fr;
    height: auto;
    padding: 1 2;
}
WikiScreen #wiki-results {
    width: 100%;
    height: auto;
}
WikiScreen .wiki-doc-title {
    width: 1fr;
    text-style: bold;
    color: $text;
    padding-bottom: 1;
}
/* title/parent on the left, version picker + edit/lock on the top-right */
WikiScreen .wiki-doc-header {
    width: 1fr;
    height: auto;
}
WikiScreen .wiki-header-left {
    width: 1fr;
    height: auto;
}
WikiScreen .wiki-header-right {
    width: auto;
    height: auto;
    align-horizontal: right;
}
WikiScreen #wiki-version-select {
    width: 28;
}

/* edit/lock button */
WikiScreen .wiki-header-buttons {
    width: 100%;
    height: auto;
    margin-top: 1;
    padding-left: 1;

    TextButton {
        padding: 0 1;
        margin-right: 2;
    }
}

WikiScreen .wiki-header-left .detail-key {
    width: 9;
}

WikiScreen .wiki-parent-link {
    color: $accent;
    text-style: underline;
}
WikiScreen .wiki-parent-link:hover {
    color: $accent-lighten-1;
    text-style: bold underline;
}
/* draw divider above the document body */
WikiScreen .wiki-divider {
    color: $primary;
    margin: 1 0 1 0;
}
WikiScreen #wiki-edit-btn { background: $primary 15%; color: $primary; }
WikiScreen #wiki-edit-btn:hover { background: $primary 30%; color: $primary; }
WikiScreen #wiki-edit-btn:focus { background: $primary !important; color: $background; }
WikiScreen #wiki-lock-btn { background: $secondary 15%; color: $secondary; }
WikiScreen #wiki-lock-btn:hover { background: $secondary 30%; color: $secondary; }
WikiScreen #wiki-lock-btn:focus { background: $secondary !important; color: $background; }
WikiScreen .wiki-version-banner {
    width: 100%;
    padding: 0 1;
    margin-bottom: 1;
    color: $warning;
    text-style: italic;
}
WikiScreen #wiki-doc-body {
    width: 100%;
    height: auto;
}
WikiScreen .wiki-search-header {
    width: 100%;
    color: $text-muted;
    padding-bottom: 1;
}
WikiScreen .wiki-muted {
    width: 100%;
    color: $text-muted;
    padding: 1 0;
}
/* detail rows reused in the document header (parent / locked) */
WikiScreen .detail-row {
    width: 100%;
    height: auto;
}
WikiScreen .detail-key {
    width: 14;
    color: $text-muted;
}
WikiScreen .detail-value {
    width: 1fr;
    color: $text;
}
