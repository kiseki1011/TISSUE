WikiScreen #screen-body {
    layout: vertical;
    padding: 1 2;  /* match HomeScreen #screen-body for a consistent outer frame */
}

WikiScreen #wiki-body {
    width: 100%;
    height: 1fr;
}

/* Left column: the search bar stacked over the tabbed sidebar at one width, so
   the viewer on the right keeps the full height. */
WikiScreen #wiki-sidebar-col {
    width: 36;
    height: 1fr;
    /* `newdoc` layer holds the overlaid "+ New Doc" button so it floats over the
       empty band under the tabs without taking layout space. */
    layers: base newdoc;
}

WikiScreen #wiki-search {
    width: 100%;
    height: 3;
    border: solid $primary;
    border-title-align: left;
}

/* Highlight the search bar's border when it has focus. */
WikiScreen #wiki-search:focus {
    border: solid $accent;
}

WikiScreen #wiki-sidebar {
    width: 100%;
    height: 1fr;
}

/* Tab header: breathing room above (1) and below (3) the docked tab bar, and
   the three tabs share the width equally (1:1:1). The bottom margin is 3 (not 2)
   so the tree starts one row lower — matching the taller (8-row) meta header on
   the right, keeping the tree and viewer at the same height. */
WikiScreen #wiki-sidebar > ContentTabs {
    margin: 1 0 3 0;
}

WikiScreen #wiki-sidebar #tabs-list {
    width: 1fr;
}

WikiScreen #wiki-sidebar #tabs-list > Tab {
    width: 1fr;
}

WikiScreen #wiki-toc-holder {
    width: 1fr;
    height: 1fr;
}

/* Padding on the inner scrollable widgets gives the sidebar breathing room;
   `scrollbar-gutter: stable` reserves the bar's column so content never reflows
   when it appears/disappears. `$panel` background matches the Contents outline
   (MarkdownTableOfContents uses $panel), so all three tabs share the same
   slightly-lighter panel shade and fill the same area even when sparse. */
WikiScreen #wiki-tree,
WikiScreen #wiki-bookmarks,
WikiScreen #wiki-results {
    width: 1fr;
    height: 1fr;
    /* Left padding 1; right padding 0 because the stable scrollbar gutter
       already reserves a column on the right. With a 1-cell scrollbar the
       left inset (1) and right inset (gutter 1) match, so a focused/hovered
       row's background is evenly inset on both sides. */
    padding: 1 0 1 1;
    scrollbar-gutter: stable;
    scrollbar-size-vertical: 1;
    background: $panel;
    /* OptionList ships a `border: tall $border-blurred` (Tree has none), which
       drew a visible line and inset its panel by 1 each side — strip it so the
       lists fill the same area as the tree. */
    border: none;
}

/* Search results share the Documents tab with the tree; shown only while a
   search is active (see _show_search_mode). */
WikiScreen #wiki-results {
    display: none;
}

/* The Contents outline (MarkdownTableOfContents) is a wrapper whose inner Tree
   already gets `padding: 1` from Textual's DEFAULT_CSS — so we DON'T pad the
   wrapper again (that double-insets Contents vs the other tabs). We only size
   the wrapper and put the stable gutter on the inner Tree that actually scrolls. */
WikiScreen #wiki-toc {
    width: 1fr;
    height: 1fr;
}

WikiScreen #wiki-toc > Tree {
    /* Override the DEFAULT_CSS `padding: 1` to `1 0 1 1` and shrink the
       scrollbar so the highlight is evenly inset on both sides — matching the
       tree / bookmarks / results lists. */
    padding: 1 0 1 1;
    scrollbar-gutter: stable;
    scrollbar-size-vertical: 1;
}

/* Right side: a fixed document-info header + heavy rule above the scrolling
   body (the viewer). */
WikiScreen #wiki-content {
    width: 1fr;
    height: 1fr;
}

/* Info header: two columns. Left = the stacked detail rows; right = a control
   stack (version picker over a bookmark toggle). Borderless (frogmouth-style,
   matching the viewer). Vertical padding 1 so the text isn't flush to the top;
   horizontal padding 2 to line the header text up with the Markdown body, whose
   own DEFAULT_CSS insets content by 2. Hidden until a document is opened. */
WikiScreen #wiki-meta {
    width: 100%;
    /* 6 info rows (Title / Tags / Version / Created / Modified / Author) + top
       padding 1 + 1 spare row = 8, so meta (8) + rule (1) = 9 rows of chrome —
       matching the left column (search 3 + tab header 6) — and the viewer below
       starts at the same row as the tree (equal heights). Pinned so it equals
       #wiki-edit-meta (no jump when toggling read/write). */
    height: 8;
    display: none;
    padding: 1 2 0 2;
    layout: horizontal;
}

/* Left column: the stacked detail rows take the remaining width, but keep a
   floor so the fixed-width control column can't squeeze the title/values down
   to an unreadable sliver on a narrow content pane. */
WikiScreen #wiki-meta-info {
    width: 1fr;
    min-width: 16;
    height: auto;
}

/* Right column: the version picker over the action grid. Fixed width (holds the
   3-button top row: set parent / bookmark / lock) so the picker lines up at the
   same x as the authoring parent picker (#wiki-edit-controls shares this width)
   — no jump when toggling read/write. */
WikiScreen #wiki-meta-controls {
    width: 45;
    height: auto;
}

/* Wide enough for "Current (vMM.mm.pp)" + the dropdown arrow. */
WikiScreen #wiki-version-select {
    width: 31;
}

/* 2x2 action grid under the picker: [bookmark][lock] / [edit][delete]. Two rows
   tall (+1 top margin). */
WikiScreen #wiki-meta-buttons {
    width: auto;
    height: 2;
    margin-top: 1;
}

WikiScreen .wiki-meta-btn-row {
    width: auto;
    height: 1;
}

/* One-row text buttons (no border box) with a filled background, so they read
   as solid toggles. The bookmark button is nudged 1 to the right; the lock
   button follows it with a 1-cell gap. Both share one fixed width for a uniform
   look: a Button's `width: auto` doesn't recompute when the label is swapped to
   the longer action word, so we pin width = longest label ("unbookmark"=10) + 4
   (measured: the box reserves ~2 beyond the padding, plus 1 centring cell each
   side); min-width matches so the default 16 doesn't widen it. */
WikiScreen #wiki-set-parent-btn,
WikiScreen #wiki-bookmark-btn,
WikiScreen #wiki-lock-btn,
WikiScreen #wiki-edit-btn,
WikiScreen #wiki-delete-btn {
    width: 14;
    min-width: 14;
    height: 1;
    min-height: 1;
    margin: 0 0 0 1;
    padding: 0 1;
    border: none;
    background: $primary;
    color: $background;
}

WikiScreen #wiki-set-parent-btn:hover,
WikiScreen #wiki-bookmark-btn:hover,
WikiScreen #wiki-lock-btn:hover,
WikiScreen #wiki-edit-btn:hover,
WikiScreen #wiki-delete-btn:hover {
    background: $accent;
    color: $background;
}

WikiScreen #wiki-set-parent-btn:focus,
WikiScreen #wiki-bookmark-btn:focus,
WikiScreen #wiki-lock-btn:focus,
WikiScreen #wiki-edit-btn:focus,
WikiScreen #wiki-delete-btn:focus {
    background: $accent;
    color: $background;
    text-style: bold;
}

/* Transparent placeholder (same footprint as a meta button) holding the empty
   bottom-left cell so edit/delete line up under bookmark/lock. */
WikiScreen .wiki-meta-btn-spacer {
    width: 14;
    height: 1;
    margin: 0 0 0 1;
}

/* The clickable parent-document link in the meta header: an underlined,
   primary-coloured label (carries an @click action) sized to its clipped title.
   Stays one row so the row height matches the others. */
WikiScreen .wiki-meta-parent-link {
    width: auto;
    height: 1;
    color: $primary;
    text-style: underline;
}

/* edit = secondary, delete = error (override the shared $primary fill). */
WikiScreen #wiki-edit-btn {
    background: $secondary;
}

WikiScreen #wiki-delete-btn {
    background: $error;
}

WikiScreen #wiki-meta-rule {
    display: none;
    /* No vertical margin so the divider sits up close to the meta and the body
       below starts at the same row as the tree on the left (the meta header +
       rule then occupy the same height as the search bar + tab header). Inset
       the line by 1 on each side so it doesn't run edge-to-edge. */
    margin: 0;
    padding: 0 1;
}

WikiScreen .detail-row {
    width: 100%;
    height: auto;
}

/* Multi-column meta rows (Version/Locked/Bookmarked and Created/Last Modified):
   each `key: value` cell is sized to its own content and packs to the left with
   a small fixed gap between cells — so the values sit right after their keys
   instead of being stretched apart across equal-width columns. */
WikiScreen .meta-pair {
    width: auto;
    height: 1;
    margin-right: 3;
}

WikiScreen .meta-pair-key {
    width: auto;
    margin-right: 1;
    color: $text-muted;
}

/* Fixed-width key (fits the widest first-column key, "Modified:") so every
   first-column value lines up at the same column. Narrowed from 14 to 9 once
   "Last Modified" became "Modified", pulling the values further left. */
WikiScreen .meta-key-wide {
    width: 9;
    margin-right: 1;
    color: $text-muted;
}

WikiScreen .meta-pair-value {
    width: auto;
    color: $text;
}

/* Tag chips line: stays one row (ellipsis on overflow) so several long tags
   can't wrap and push the pinned-height meta header out of alignment. */
WikiScreen #wiki-meta-tags {
    width: 1fr;
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* For the two-column rows (_pair2): the left value sits in a fixed-width slot so
   the second column's key starts at the same x on every such row; the second
   key is fixed-width so its value (the 🔒/⭐ marker) aligns too. */
WikiScreen .meta-val-slot {
    width: 20;
    margin-right: 1;
    color: $text;
}

WikiScreen .meta-key-2 {
    width: 10;
    color: $text-muted;
}

/* Title value stands out (bold + primary), matching the dashboard Key styling.
   Takes the row's remaining width after the "Title:" key and stays a single line
   (ellipsis on overflow) so the header is always the same height and the body
   below stays aligned with the tree. */
WikiScreen .wiki-meta-title {
    width: 1fr;
    color: $primary;
    text-style: bold;
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* Markdown viewer fills the remaining width and height below the header.
   Borderless (frogmouth-style) so it reads as a clean reading pane. Hidden
   until a document is opened (the placeholder shows until then). */
WikiScreen #wiki-viewer {
    width: 100%;
    height: 1fr;
    display: none;
}

/* Pre-open placeholder: centred italic prompt occupying the same vertical band
   as the tree on the left. The `margin-top: 9` reserves the height of the left
   column's chrome above the tree — search bar (3) + tab header (2 + 1/3
   margins = 6) — so the empty reading area lines up with the tree. */
WikiScreen #wiki-placeholder {
    width: 100%;
    height: 1fr;
    margin-top: 9;
    content-align: center middle;
    text-style: italic;
    color: $text-muted;
}

/* "+ New Doc" floats (own layer + dock) over the empty band just below the tab
   row, right-aligned, so adding it never pushes the tree/lists down. The offset
   places it: x = sidebar width (36) - button width (13) = 23 → flush right;
   y = search bar (3) + tab row with top margin (3) = 6 rows down from the column
   top → into the tab's bottom-margin band. Opens the draft editor on the right. */
WikiScreen #wiki-newdoc-btn {
    layer: newdoc;
    dock: top;
    offset: 23 6;
    width: 13;
    min-width: 13;
    height: 1;
    min-height: 1;
    padding: 0 1;
    border: none;
    background: $primary;
    color: $background;
}

WikiScreen #wiki-newdoc-btn:hover,
WikiScreen #wiki-newdoc-btn:focus {
    background: $accent;
    color: $background;
}

/* Local drafts: a labelled list at the bottom of the Documents pane (panel
   shade + insets matching the tree). The header + list are toggled together in
   _reload_drafts — shown only when a draft exists — so both start hidden. */
WikiScreen #wiki-drafts-header {
    display: none;
    width: 1fr;
    height: 1;
    padding: 0 1;
    color: $text-muted;
    text-style: bold;
}

WikiScreen #wiki-drafts {
    display: none;
    width: 1fr;
    height: auto;
    max-height: 10;
    padding: 0 0 1 1;
    scrollbar-gutter: stable;
    scrollbar-size-vertical: 1;
    background: $panel;
    border: none;
}

/* ---- authoring (draft editor) ------------------------------------------- */

/* Replaces the read-only meta header while writing. Same height + insets as the
   read-mode #wiki-meta (8, top padding only) so the divider and body sit at the
   same row whether reading or writing (and align with the tree). Two columns
   (title/tags inputs | parent picker over the buttons), mirroring the read meta.
   Hidden until +New Doc. */
WikiScreen #wiki-edit-meta {
    display: none;
    width: 100%;
    height: 8;
    padding: 1 2 0 2;
    layout: horizontal;
}

/* Left column: title + tags rows take the remaining width. */
WikiScreen #wiki-edit-info {
    width: 1fr;
    min-width: 16;
    height: auto;
}

/* Right column: the parent picker over the save/cancel buttons (mirrors the
   read-mode controls). Same fixed width as #wiki-meta-controls so the parent
   picker lands at the same x as the read-mode version picker. */
WikiScreen #wiki-edit-controls {
    width: 45;
    height: auto;
}

/* Same width as the read-mode version picker, in the same slot. */
WikiScreen #wiki-parent-select {
    width: 31;
}

WikiScreen .wiki-edit-row {
    width: 100%;
    height: 1;
}

WikiScreen .wiki-edit-key {
    width: 7;
    color: $text-muted;
}

/* Borderless single-line field with a subtle fill so it still reads as input. */
WikiScreen .wiki-edit-input {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0 1;
    background: $boost;
}

/* Authoring tags display (chosen tags shown when a draft with frontmatter tags
   is opened); one row, ellipsis on overflow. */
WikiScreen #wiki-edit-tags-display {
    width: 1fr;
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    color: $text;
}

/* 2x2 button block (2 rows of 1) under the parent picker in the right-hand
   control column. Left column = save draft (row 1) / save (row 2), right
   column = cancel (row 2); the top-right cell is held by an invisible spacer so
   save draft lines up above save. */
WikiScreen #wiki-edit-buttons {
    width: auto;
    height: 2;
    margin-top: 1;
}

WikiScreen .wiki-edit-btn-row {
    width: auto;
    height: 1;
}

/* Transparent placeholder (same footprint as a button) holding the empty cell
   under preview so save lines up directly below save draft. */
WikiScreen .wiki-edit-btn-spacer {
    width: 14;
    height: 1;
    margin: 0 0 0 1;
}

/* All four share "save draft"'s width (14) for a uniform block. */
WikiScreen #wiki-preview-btn,
WikiScreen #wiki-draft-save-btn,
WikiScreen #wiki-save-btn,
WikiScreen #wiki-edit-cancel-btn {
    width: 14;
    min-width: 14;
    height: 1;
    min-height: 1;
    padding: 0 1;
    margin: 0 0 0 1;
    border: none;
    background: $primary;
    color: $background;
}

/* preview/edit toggle = secondary, save = success, cancel = error. */
WikiScreen #wiki-preview-btn {
    background: $secondary;
}

WikiScreen #wiki-save-btn {
    background: $success;
}

WikiScreen #wiki-edit-cancel-btn {
    background: $error;
}

WikiScreen #wiki-preview-btn:hover,
WikiScreen #wiki-preview-btn:focus,
WikiScreen #wiki-draft-save-btn:hover,
WikiScreen #wiki-draft-save-btn:focus,
WikiScreen #wiki-save-btn:hover,
WikiScreen #wiki-save-btn:focus {
    background: $accent;
    color: $background;
}

WikiScreen #wiki-edit-cancel-btn:hover,
WikiScreen #wiki-edit-cancel-btn:focus {
    background: $error-darken-1;
    color: $background;
}

/* The draft body editor occupies the viewer's slot while authoring. */
WikiScreen #wiki-editor {
    display: none;
    width: 100%;
    height: 1fr;
    border: none;
    padding: 0 1;
}

/* The rendered draft preview shares the editor's slot; shown only when the
   preview toggle is on (see _start_preview / _end_preview). */
WikiScreen #wiki-preview {
    display: none;
    width: 100%;
    height: 1fr;
}
