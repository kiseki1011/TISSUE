TagPickerModal {
    align: center middle;
    background: $background 60%;
}

TagPickerModal #tag-picker-dialog {
    width: 60;
    max-width: 90%;
    min-width: 44;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border-title-align: center;
    border-title-color: $accent;
    border-subtitle-align: center;
    border-subtitle-color: $text-muted;
}

TagPickerModal #tag-picker-input {
    width: 100%;
}

/* Colour picker + Add button row, directly under the name input (no gap — the
   spacing between the input and this row was reduced by 1). */
TagPickerModal #tag-picker-add-row {
    width: 100%;
    height: auto;
    margin-top: 0;
}

TagPickerModal #tag-picker-colour {
    width: 1fr;
}

TagPickerModal #tag-picker-add {
    width: auto;
    min-width: 10;
    margin-left: 1;
}

/* Status line: muted by default, red for validation errors (-error). */
TagPickerModal .status-msg {
    width: 100%;
    height: auto;
    margin-top: 1;
    color: $text-muted;
}

TagPickerModal .status-msg.-error {
    color: $error;
}

/* Chosen tags, packed into rows (a Vertical of Horizontal rows) so long tags
   wrap to the next line instead of overflowing. */
TagPickerModal #tag-picker-selected {
    width: 100%;
    height: auto;
    margin-top: 1;
}

TagPickerModal .tag-chip-row {
    width: 100%;
    height: 1;
}

/* The chip's fill comes from its label (a pill coloured with the tag's own
   colour), so the button itself is transparent. Clicking removes it (the ✕ in
   the label is the cue). Hover/focus highlight it with a translucent tint +
   bold so the focused/hovered chip stands out over its colour. */
TagPickerModal .tag-chip {
    width: auto;
    min-width: 0;
    height: 1;
    margin: 0 1 0 0;
    padding: 0;
    border: none;
    background: transparent;
}

TagPickerModal .tag-chip:hover {
    background: transparent;
    tint: $foreground 20%;
}

TagPickerModal .tag-chip:focus {
    background: transparent;
    tint: $foreground 35%;
    text-style: bold;
}

TagPickerModal .tag-empty {
    width: auto;
    height: 1;
    color: $text-muted;
    text-style: italic;
}

TagPickerModal #tag-picker-buttons {
    width: 100%;
    height: auto;
    align-horizontal: right;
    margin-top: 1;
}

TagPickerModal #tag-picker-buttons Button {
    margin-left: 1;
    min-width: 12;
}
