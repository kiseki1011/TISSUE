AccountModal {
    align: center middle;
    background: $background 60%;
}

#account-dialog {
    width: 66;
    height: auto;
    max-height: 90%;
    padding: 0;
    border-title-align: center;
    border-subtitle-align: center;
}

#account-inner {
    width: 1fr;
    height: auto;
    padding: 1 3;
}

/* Image on the left, info on the right, with a gap of 2 between them. */
#account-top {
    width: 100%;
    height: auto;
    align-vertical: middle;
}

.account-image-wrap {
    width: auto;
    height: auto;
    margin-right: 4;
}

.account-image {
    width: 18;
    height: 9;
}

.account-info {
    width: 1fr;
    height: auto;
}

.account-info-row {
    width: 100%;
    height: 1;
    margin-bottom: 1;
}

.account-info-key {
    width: 13;
    color: $text-muted;
    text-style: bold;
}

.account-info-value {
    width: 1fr;
}

/* Pencil that opens the single-field edit modal; value (1fr) floats it right. */
.account-edit-icon {
    width: auto;
    min-width: 1;
    margin-left: 1;
    color: $text-muted;
}

.account-divider {
    width: 100%;
    margin: 1 0;
    color: $primary;
}

.account-actions {
    width: 100%;
    height: auto;
    align-horizontal: right;
}

.account-actions Button {
    margin-left: 1;
    min-width: 12;
}
