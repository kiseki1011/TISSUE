Button {
    border: round $primary;
}

Button:focus {
    border: round $accent;
    color: $accent;
    background-tint: transparent 0%;
    text-style: bold;
    background: transparent;
}

Button:hover {
    background: $surface-lighten-1;
}

Input {
    border: round $primary;
}

Input:focus {
    border: round $accent;
    color: $accent;
    border-title-color: $accent;
    background: transparent;
}

Input > .input--placeholder {
    text-style: italic;
}

Input.-error {
    border: round $error;
    color: $error;
    border-title-color: $error;
}

.dialog {
    background: $surface;
    border: round $primary;
}

.panel {
    border: round $primary;
}

.panel:focus {
    border: round $accent;
}

/* subtitle text inside a dialog, under the logo */
.dialog-subtitle {
    text-align: center;
    color: $text-muted;
    width: 100%;
}

/* inline status message under a form input */
.status-msg {
    height: 1;
    padding-left: 1;
    width: 100%;
    text-align: left;
    color: $text-muted;
}

.status-msg.-error {
    color: $error;
}

.primary { color: $primary; }
.secondary { color: $secondary; }
.error { color: $error; }
.warning { color: $warning; }
.success { color: $success; }

/* border style overrides (toggled through App) */
App.-border-solid {
    Button, Input, .dialog, .panel { border: solid $primary; }
    Button:focus, Input:focus, .panel:focus { border: solid $accent; }
    Input.-error { border: solid $error; }
}

App.-border-heavy {
    Button, Input, .dialog, .panel { border: heavy $primary; }
    Button:focus, Input:focus, .panel:focus { border: heavy $accent; }
    Input.-error { border: heavy $error; }
}

App.-border-dashed {
    Button, Input, .dialog, .panel { border: dashed $primary; }
    Button:focus, Input:focus, .panel:focus { border: dashed $accent; }
    Input.-error { border: dashed $error; }
}

App.-border-double {
    Button, Input, .dialog, .panel { border: double $primary; }
    Button:focus, Input:focus, .panel:focus { border: double $accent; }
    Input.-error { border: double $error; }
}

App.-border-hkey {
    Button, Input, .dialog, .panel { border: hkey $primary; }
    Button:focus, Input:focus, .panel:focus { border: hkey $accent; }
    Input.-error { border: hkey $error; }
}

App.-border-tab {
    Button, Input, .dialog, .panel { border: tab $primary; }
    Button:focus, Input:focus, .panel:focus { border: tab $accent; }
    Input.-error { border: tab $error; }
}

App.-border-ascii {
    Button, Input, .dialog, .panel { border: ascii $primary; }
    Button:focus, Input:focus, .panel:focus { border: ascii $accent; }
    Input.-error { border: ascii $error; }
}
