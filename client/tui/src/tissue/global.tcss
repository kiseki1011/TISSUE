Button {
    border: solid $primary;
}

Button:focus {
    border: solid $accent;
    color: $accent;
    background-tint: transparent 0%;
    text-style: bold;
    background: $surface-lighten-1;
}

Button:hover {
    background: $surface-lighten-1;
}

Input {
    border: solid $primary;
}

Input:focus {
    border: solid $accent;
    color: $accent;
    border-title-color: $accent;
    background: transparent;
}

Input > .input--placeholder {
    text-style: italic;
}

Input.-error {
    border: solid $error;
    color: $error;
    border-title-color: $error;
}

Checkbox {
    border: solid $primary;
}

Checkbox:focus {
    border: solid $accent;
}

/* Match the Select's closed box to our buttons (border style/color/size). */
SelectCurrent {
    border: solid $primary;
}

Select:focus > SelectCurrent {
    border: solid $accent;
}

TextArea {
    border: solid $primary;
}

TextArea:focus {
    border: solid $accent;
    border-title-color: $accent;
}

.dialog {
    background: $surface;
    border: solid $primary;
}

.panel {
    border: solid $primary;
}

.panel:focus {
    border: solid $accent;
}

/* TextButton has its own no-border style */
TextButton, TextButton:focus, TextButton:hover {
    border: none;
    background: transparent;
}

/* Subtitle text inside a dialog, under the logo */
.dialog-subtitle {
    text-align: center;
    color: $text-muted;
    width: 100%;
}

/* Inline status message under a form input */
.status-msg {
    height: 1;
    padding-left: 1;
    width: 100%;
    text-align: left;
    color: $text-muted;
}

.status-msg.-error {
    color: $error;
}

.status-msg.-success {
    color: $success;
}

.status-msg.-waiting {
    color: $text-muted;
}

.placeholder {
    color: $text-muted;
    text-style: italic;
    width: 100%;
    text-align: center;
    padding: 4 0;
}

.primary { color: $primary; }
.secondary { color: $secondary; }
.error { color: $error; }
.warning { color: $warning; }
.success { color: $success; }

/*
 * Colored action-button variants (hardcoded solid border).
 * Class selectors beat the generic `Button` rule; placed after it so the
 * :focus variants win on the specificity tie.
 */
.-btn-secondary { border: solid $secondary; color: $secondary; border-title-color: $secondary; }
.-btn-secondary:focus { border: solid $accent; color: $accent; border-title-color: $accent; }
.-btn-success { border: solid $success; color: $success; border-title-color: $success; }
.-btn-success:focus { border: solid $accent; color: $accent; border-title-color: $accent; }
.-btn-warning { border: solid $warning; color: $warning; border-title-color: $warning; }
.-btn-warning:focus { border: solid $accent; color: $accent; border-title-color: $accent; }
.-btn-error { border: solid $error; color: $error; border-title-color: $error; }
.-btn-error:focus { border: solid $accent; color: $accent; border-title-color: $accent; }

/* TextButton focus highlight */
TextButton:focus {
    background: $primary !important;
    color: $background;
    text-style: bold;
}
