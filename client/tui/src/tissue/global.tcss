Button {
    border: round $primary;
}

Button:focus {
    border: round $accent;
    color: $accent;
    background-tint: transparent 0%;
    text-style: bold;
    background: $surface-lighten-1;
}

Button:hover {
    background: $surface-lighten-1;
}

Input {
    border: round $primary;
}

Input:focus {
    border: round $accent;
    color: $accent;
    border-title-color: $accent;
    background: transparent;
}

Input > .input--placeholder {
    text-style: italic;
}

Input.-error {
    border: round $error;
    color: $error;
    border-title-color: $error;
}

TextArea {
    border: round $primary;
}

TextArea:focus {
    border: round $accent;
    border-title-color: $accent;
}

.dialog {
    background: $surface;
    border: round $primary;
}

.panel {
    border: round $primary;
}

.panel:focus {
    border: round $accent;
}

/* TextButton has its own no-border style */
TextButton, TextButton:focus, TextButton:hover {
    border: none;
    background: transparent;
}

/* Subtitle text inside a dialog, under the logo */
.dialog-subtitle {
    text-align: center;
    color: $text-muted;
    width: 100%;
}

/* Inline status message under a form input */
.status-msg {
    height: 1;
    padding-left: 1;
    width: 100%;
    text-align: left;
    color: $text-muted;
}

.status-msg.-error {
    color: $error;
}

.status-msg.-success {
    color: $success;
}

.status-msg.-waiting {
    color: $text-muted;
}

.placeholder {
    color: $text-muted;
    text-style: italic;
    width: 100%;
    text-align: center;
    padding: 4 0;
}

.primary { color: $primary; }
.secondary { color: $secondary; }
.error { color: $error; }
.warning { color: $warning; }
.success { color: $success; }

/* 
 * Border style overrides (toggled through App).
 * TextButton resets are listed last in each group so they win over the
 * generic Button rule. 
 */
App.-border-solid {
    Button, Input, TextArea, .dialog, .panel { border: solid $primary; }
    Button:focus, Input:focus, TextArea:focus, .panel:focus { border: solid $accent; }
    Input.-error { border: solid $error; }
    TextButton, TextButton:focus, TextButton:hover { border: none; background: transparent; }
}

App.-border-heavy {
    Button, Input, TextArea, .dialog, .panel { border: heavy $primary; }
    Button:focus, Input:focus, TextArea:focus, .panel:focus { border: heavy $accent; }
    Input.-error { border: heavy $error; }
    TextButton, TextButton:focus, TextButton:hover { border: none; background: transparent; }
}

App.-border-dashed {
    Button, Input, TextArea, .dialog, .panel { border: dashed $primary; }
    Button:focus, Input:focus, TextArea:focus, .panel:focus { border: dashed $accent; }
    Input.-error { border: dashed $error; }
    TextButton, TextButton:focus, TextButton:hover { border: none; background: transparent; }
}

App.-border-double {
    Button, Input, TextArea, .dialog, .panel { border: double $primary; }
    Button:focus, Input:focus, TextArea:focus, .panel:focus { border: double $accent; }
    Input.-error { border: double $error; }
    TextButton, TextButton:focus, TextButton:hover { border: none; background: transparent; }
}

App.-border-hkey {
    Button, Input, TextArea, .dialog, .panel { border: hkey $primary; }
    Button:focus, Input:focus, TextArea:focus, .panel:focus { border: hkey $accent; }
    Input.-error { border: hkey $error; }
    TextButton, TextButton:focus, TextButton:hover { border: none; background: transparent; }
}

App.-border-tab {
    Button, Input, TextArea, .dialog, .panel { border: tab $primary; }
    Button:focus, Input:focus, TextArea:focus, .panel:focus { border: tab $accent; }
    Input.-error { border: tab $error; }
    TextButton, TextButton:focus, TextButton:hover { border: none; background: transparent; }
}

App.-border-ascii {
    Button, Input, TextArea, .dialog, .panel { border: ascii $primary; }
    Button:focus, Input:focus, TextArea:focus, .panel:focus { border: ascii $accent; }
    Input.-error { border: ascii $error; }
    TextButton, TextButton:focus, TextButton:hover { border: none; background: transparent; }
}

/* TextButton focus highlight */
TextButton:focus {
    background: $primary !important;
    color: $background;
    text-style: bold;
}
