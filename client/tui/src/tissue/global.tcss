Button {
    border: solid $primary;
}

/* textual-timepiece styles its own inputs/buttons flat (the picker's input row
   and the calendar/time-cell grids). The app-wide Input/Button borders above
   would box each inner widget — squashing the 1-row input controls and hiding the
   grid labels — so neutralise borders inside the picker. The picker's own
   input-control wrapper supplies the focus border. */
DateTimePicker Input,
DateTimePicker Input:focus,
DateTimePicker Button,
DateTimePicker Button:focus {
    border: none;
}

/* Focus changes only the border/text (not the background); the background
   highlight is reserved for :hover. */
Button:focus {
    border: solid $accent;
    color: $accent;
    background-tint: transparent 0%;
    text-style: bold;
}

Button:hover {
    background: $surface-lighten-1;
}

Input {
    border: solid $primary;
}

Input:focus {
    border: solid $accent;
    color: $accent;
    border-title-color: $accent;
    background: transparent;
}

Input > .input--placeholder {
    text-style: italic;
}

Input.-error {
    border: solid $error;
    color: $error;
    border-title-color: $error;
}

Checkbox {
    border: solid $primary;
}

Checkbox:focus {
    border: solid $accent;
}

/* Match the Select's closed box to our buttons (border style/color/size). */
SelectCurrent {
    border: solid $primary;
}

Select:focus > SelectCurrent {
    border: solid $accent;
}

TextArea {
    border: solid $primary;
}

TextArea:focus {
    border: solid $accent;
    border-title-color: $accent;
}

.dialog {
    background: $surface;
    border: solid $primary;
}

.panel {
    border: solid $primary;
}

.panel:focus {
    border: solid $accent;
}

/* TextButton has its own no-border style */
TextButton, TextButton:focus, TextButton:hover {
    border: none;
    background: transparent;
}

/* Small square button beside a search bar (same height as the input); opens a
   filter/sort modal. Width is fixed and min-width dropped so it stays compact. */
.search-filter-btn {
    width: 5;
    min-width: 0;
    height: 3;
    margin-left: 1;
}

/* Subtitle text inside a dialog, under the logo */
.dialog-subtitle {
    text-align: center;
    color: $text-muted;
    width: 100%;
}

/* Inline status message under a form input */
.status-msg {
    height: 1;
    padding-left: 1;
    width: 100%;
    text-align: left;
    color: $text-muted;
}

.status-msg.-error {
    color: $error;
}

.status-msg.-success {
    color: $success;
}

.status-msg.-waiting {
    color: $text-muted;
}

.placeholder {
    color: $text-muted;
    text-style: italic;
    width: 100%;
    text-align: center;
    padding: 4 0;
}

/* Custom-field section in a detail pane (shared by the dashboard + project hub).
   .detail-gap is the blank line above the section; .cf-text renders a TEXT custom
   field's value as a borderless Markdown box (padding 0 so it lines up with the
   rows above). */
.detail-gap {
    height: 1;
}
.cf-text {
    width: 1fr;
    height: auto;
    padding: 0;
}

.primary { color: $primary; }
.secondary { color: $secondary; }
.error { color: $error; }
.warning { color: $warning; }
.success { color: $success; }

/*
 * Colored action-button variants (hardcoded solid border).
 * Class selectors beat the generic `Button` rule; placed after it so the
 * :focus variants win on the specificity tie.
 */
.-btn-secondary { border: solid $secondary; color: $secondary; border-title-color: $secondary; }
.-btn-secondary:focus { border: solid $accent; color: $accent; border-title-color: $accent; }
.-btn-success { border: solid $success; color: $success; border-title-color: $success; }
.-btn-success:focus { border: solid $accent; color: $accent; border-title-color: $accent; }
.-btn-warning { border: solid $warning; color: $warning; border-title-color: $warning; }
.-btn-warning:focus { border: solid $accent; color: $accent; border-title-color: $accent; }
.-btn-error { border: solid $error; color: $error; border-title-color: $error; }
.-btn-error:focus { border: solid $accent; color: $accent; border-title-color: $accent; }

/* TextButton focus highlight */
TextButton:focus {
    background: $primary !important;
    color: $background;
    text-style: bold;
}

/* Footer command shortcuts: a subtle raised background on the key chip, and a
   single space on each side of the description (between the key and the
   description, and after it before the next shortcut). */
FooterKey > .footer-key--key {
    background: $panel-lighten-1;
}
FooterKey > .footer-key--description {
    padding: 0 1;
}
