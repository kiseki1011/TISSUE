InvitationsPanel {
    height: 1fr;
    width: 100%;
}

InvitationsPanel > Vertical {
    height: 1fr;
    width: 100%;
}

InvitationsPanel .panel-heading {
    height: 3;
    text-style: bold;
    color: $accent;
    padding: 1 0;
    width: 100%;
}

InvitationsPanel .empty-state {
    align: center middle;
    height: 5;
    color: $text-muted;
    text-style: italic;
    text-align: center;
    width: 100%;
    padding: 1 0;
    display: none;
}

InvitationsPanel #inv_list {
    background: transparent;
    border: round $primary-darken-2;
    height: 1fr;
}

InvitationsPanel ListItem {
    background: transparent;
    padding: 0 1;
    height: auto;
}

InvitationsPanel ListItem > Vertical {
    height: auto;
    width: 100%;
    padding: 0 0 1 0;
}

InvitationsPanel .inv-row {
    height: 3;
    width: 100%;
    align: right middle;
}

InvitationsPanel .inv-ws {
    width: 1fr;
    color: $accent;
    text-style: bold;
}

InvitationsPanel .inv-row Button {
    width: auto;
    min-width: 10;
    margin: 0 1;
}

InvitationsPanel .inv-projects {
    width: 100%;
    color: $text-muted;
    padding: 0 1;
}

InvitationsPanel .inv-inviter {
    width: 100%;
    color: $text-muted;
    padding: 0 1;
}
