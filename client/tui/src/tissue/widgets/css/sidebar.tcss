Sidebar {
    width: 24;
    height: 1fr;
    border-right: tall $primary;
    transition: width 200ms in_out_cubic;
}

Sidebar.-collapsed {
    width: 4;
}

Sidebar #sidebar_items {
    background: transparent;
    border: none;
    height: 1fr;
}

Sidebar #sidebar_items:focus {
    background: transparent;
}

Sidebar #sidebar_user_slot {
    dock: bottom;
    height: 3;
    padding: 0 1;
    border-top: solid $primary-darken-1;
    background: transparent;
}

Sidebar #sidebar_user_slot:focus {
    background: $primary 20%;
}

Sidebar #sidebar_user_slot Label {
    width: 100%;
    text-align: center;
    color: $text-muted;
}

Sidebar.-collapsed #sidebar_user_slot Label {
    display: none;
}
