WorkspacesPanel {
    height: 1fr;
    width: 100%;
}

WorkspacesPanel > Vertical {
    height: 1fr;
    width: 100%;
}

WorkspacesPanel .panel-header {
    height: 3;
    align: right middle;
    padding: 0 1;
}

WorkspacesPanel .panel-heading {
    width: 1fr;
    text-style: bold;
    color: $accent;
    padding: 1 0;
}

WorkspacesPanel #create_btn {
    width: auto;
    min-width: 10;
    height: 1;
    margin: 0;
}

WorkspacesPanel .empty-state {
    align: center middle;
    height: 5;
    color: $text-muted;
    text-style: italic;
    text-align: center;
    width: 100%;
    padding: 1 0;
    display: none;
}

WorkspacesPanel #ws_list {
    background: transparent;
    border: round $primary-darken-2;
    height: 1fr;
}

WorkspacesPanel ListItem {
    background: transparent;
    padding: 0 1;
    height: 1;
}

WorkspacesPanel ListItem > Horizontal {
    height: 1;
    width: 100%;
}

WorkspacesPanel .ws-key {
    width: 24;
    color: $accent;
}

WorkspacesPanel .ws-name {
    width: 30;
    color: $foreground;
}

WorkspacesPanel .ws-desc {
    width: 1fr;
    color: $text-muted;
}
