SocialButton {
    width: 1fr;
    height: 3;
    border: round $primary;
    background: transparent;
    color: $primary;
    padding: 0 1;
}

SocialButton:focus {
    border: round $accent;
    color: $accent;
}

SocialButton > Horizontal {
    width: 100%;
    height: 1;
}

SocialButton .-social-icon {
    width: 2;
    height: 1;
    margin-right: 1;
}

SocialButton #social-label {
    width: 1fr;
    height: 1;
    content-align: center middle;
}

SocialButton .-social-spacer {
    width: 3;
    height: 1;
}
