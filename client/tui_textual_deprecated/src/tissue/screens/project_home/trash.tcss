TrashScreen #trash-body {
    layout: vertical;
    padding: 1 2;
}

TrashScreen #trash-toolbar {
    width: 100%;
    height: auto;
    layout: grid;
    grid-size: 2 1;
    grid-columns: 4fr 3fr;
    grid-gutter: 1;
}

/* CTRL+F expands [1] to full width */
TrashScreen.-trash-expanded #trash-toolbar {
    grid-size: 1 1;
    grid-columns: 1fr;
    grid-gutter: 0;
}
TrashScreen #trash-toolbar-list {
    width: 100%;
    height: auto;
    align-horizontal: right;
}
/* Borderless toggle */
TrashScreen #trash-mine {
    margin-left: 0;
    width: auto;
    height: auto;
    border: none;
    background: transparent;
}
TrashScreen #trash-grid {
    width: 100%;
    height: 1fr;
    layout: grid;
    grid-size: 2 1;
    grid-columns: 4fr 3fr;
    grid-rows: 1fr;
    grid-gutter: 1;
}

/* CTRL+F closes [2] */
TrashScreen.-trash-expanded #trash-grid {
    grid-size: 1 1;
    grid-columns: 1fr;
    grid-gutter: 0;
}
TrashScreen.-trash-expanded #trash-detail-box {
    display: none;
}
TrashScreen .trash-box {
    width: 100%;
    height: 100%;
    border: round $primary;
    border-title-color: $primary;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
    padding: 0 1;
}

TrashScreen #trash-list-box {
    padding: 0 1 0 1;
}
TrashScreen #trash-list-box:focus-within,
TrashScreen #trash-detail-box:focus-within {
    border: round $accent;
    border-title-color: $accent;
}

/* Restore stays bottom right */
TrashScreen #trash-detail-box {
    layout: vertical;
}
TrashScreen #trash-detail-scroll {
    width: 100%;
    height: 1fr;
    scrollbar-gutter: stable;
    padding: 1 2;
}
TrashScreen #trash-detail-actions {
    width: 100%;
    height: auto;
    align-horizontal: right;
    padding: 0 1 1 0;
}
TrashScreen .trash-restore-btn {
    width: auto;
    min-width: 0;
    padding: 0 1;
    background: transparent;
}
TrashScreen .hub-table {
    height: 1fr;
    border: none;
}
TrashScreen .trash-empty,
TrashScreen .trash-muted {
    width: 100%;
    height: auto;
    color: $text-muted;
    padding: 1;
}

TrashScreen .trash-empty {
    padding: 2 1 1 2;
}
TrashScreen .trash-title {
    width: 100%;
    text-style: bold;
    color: $text;
    padding-bottom: 1;
}

/* Description heading + rendered markdown body */
TrashScreen .trash-section-title {
    width: 100%;
    text-style: bold;
    color: $text;
    padding-top: 1;
}
TrashScreen .trash-content {
    width: 100%;
    height: auto;
    padding: 0;
}

/* key:value rows */
TrashScreen .detail-row {
    width: 100%;
    height: auto;
}
TrashScreen .detail-key {
    width: 15;
    color: $text-muted;
}
TrashScreen .detail-value {
    width: 1fr;
    color: $text;
}
