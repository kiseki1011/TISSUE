EditIssueModal {
    align: center middle;
}

EditIssueModal #eim-dialog {
    width: 80;
    max-width: 90%;
    height: 38;
    max-height: 90%;
    padding: 2 0 1 0;
    layout: vertical;
}

EditIssueModal #eim-scroll {
    width: 100%;
    height: 1fr;
    scrollbar-gutter: stable;
}
EditIssueModal #eim-form {
    width: 100%;
    height: auto;
    padding: 0 5;
}

EditIssueModal Input,
EditIssueModal Select,
EditIssueModal TextArea,
EditIssueModal SelectionList,
EditIssueModal Switch,
EditIssueModal .cf-date,
EditIssueModal .cf-datetime {
    border-title-color: $primary;
    border-title-style: bold;
}

EditIssueModal Select {
    border: round $primary;
    height: auto;
}
EditIssueModal Select:focus-within {
    border: round $accent;
    border-title-color: $accent;
}
EditIssueModal Select > SelectCurrent,
EditIssueModal Select:focus > SelectCurrent {
    border: none !important;
    padding: 0 1;
}
EditIssueModal #eim-due,
EditIssueModal .cf-date,
EditIssueModal .cf-datetime {
    border: round $primary;
    height: 3;
}
EditIssueModal #eim-due:focus-within,
EditIssueModal .cf-date:focus-within,
EditIssueModal .cf-datetime:focus-within {
    border: round $accent;
    border-title-color: $accent;
}
EditIssueModal #eim-due > #input-control,
EditIssueModal .cf-date > #input-control,
EditIssueModal .cf-datetime > #input-control {
    border: none;
    height: 1;
    padding: 0;
}

EditIssueModal #eim-title,
EditIssueModal #eim-sp {
    width: 100%;
    margin-bottom: 1;
}

/* Priority and Due share a row, split 1:1 with a gap. */
EditIssueModal #eim-pd-row {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}
EditIssueModal #eim-priority,
EditIssueModal #eim-due {
    width: 1fr;
}
EditIssueModal #eim-priority {
    margin-right: 1;
}

EditIssueModal #eim-content {
    width: 100%;
    height: 8;
    margin-bottom: 1;
}

EditIssueModal .custom-field-input {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}
EditIssueModal .custom-field-input .cf-input,
EditIssueModal .custom-field-input .cf-select,
EditIssueModal .custom-field-input .cf-bar,
EditIssueModal .custom-field-input .cf-date,
EditIssueModal .custom-field-input .cf-datetime {
    width: 100%;
}
EditIssueModal .custom-field-input .cf-switch {
    width: 100%;
    border: round $primary;
}
EditIssueModal .custom-field-input .cf-text {
    width: 100%;
    height: 6;
}
EditIssueModal .custom-field-input .cf-checklist {
    width: 100%;
    height: auto;
    max-height: 10;
    border: round $primary;
}
EditIssueModal .custom-field-input .cf-checklist:focus-within {
    border: round $accent;
}

EditIssueModal #eim-status {
    width: 100%;
    height: auto;
    color: $error;
    padding: 0 5;
    margin-top: 1;
}

EditIssueModal #eim-actions {
    width: 100%;
    height: auto;
    align-horizontal: right;
    padding: 0 5;
    margin-top: 1;
}
EditIssueModal #eim-actions Button {
    width: auto;
    min-width: 0;
    padding: 0 1;
    margin-left: 1;
}
