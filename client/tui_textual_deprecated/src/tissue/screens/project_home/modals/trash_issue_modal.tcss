TrashIssueModal {
    align: center middle;
    background: $background 60%;
}

TrashIssueModal #tim-dialog {
    width: 80;
    max-width: 90%;
    height: 32;
    max-height: 90%;
    padding: 1 0 0 0;
    layout: vertical;
    border-title-align: center;
    border-subtitle-align: center;
    border-subtitle-color: $text-muted;
}

TrashIssueModal #tim-scroll {
    width: 100%;
    height: 1fr;
    scrollbar-gutter: stable;
    padding: 0 3;
}

/* Restore pinned bottom-right, outside the scroll. */
TrashIssueModal #tim-actions {
    width: 100%;
    height: auto;
    align-horizontal: right;
    padding: 0 3 1 0;
}

TrashIssueModal .trash-restore-btn {
    width: auto;
    min-width: 0;
    padding: 0 1;
    background: transparent;
}

TrashIssueModal .trash-title {
    width: 100%;
    text-style: bold;
    color: $text;
    padding-bottom: 1;
}
TrashIssueModal .detail-row {
    width: 100%;
    height: auto;
}
TrashIssueModal .detail-key {
    width: 15;
    color: $text-muted;
}
TrashIssueModal .detail-value {
    width: 1fr;
    color: $text;
}
TrashIssueModal .trash-section-title {
    width: 100%;
    text-style: bold;
    color: $text;
    padding-top: 1;
}
TrashIssueModal .trash-content {
    width: 100%;
    height: auto;
    padding: 0;
}
TrashIssueModal .trash-muted {
    width: 100%;
    height: auto;
    color: $text-muted;
    padding: 1 0;
}
