SprintTransitionModal {
    align: center middle;
}
SprintTransitionModal #str-dialog {
    width: 60;
    max-width: 90%;
    height: auto;
    padding: 1 2;
}
SprintTransitionModal #str-dialog.-expanded {
    width: 85;
    height: 28;
}
SprintTransitionModal #str-dialog.-expanded .str-actions {
    dock: bottom;
}
SprintTransitionModal #str-radio {
    width: 100%;
    margin-bottom: 1;
    border: none;
    background: $panel;
}
SprintTransitionModal #str-due-row {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}
SprintTransitionModal .str-due-label {
    width: auto;
    padding: 1 1 0 1;
}
SprintTransitionModal #str-due {
    width: 1fr;
}
SprintTransitionModal #str-status {
    width: 100%;
    height: auto;
    color: $error;
    margin-bottom: 1;
}
SprintTransitionModal .str-actions {
    width: 100%;
    height: auto;
    align-horizontal: right;
}
SprintTransitionModal .str-actions Button {
    width: auto;
    min-width: 0;
    padding: 0 1;
    margin-left: 1;
}
