IssueDetailModal {
    align: center middle;
    background: $background 60%;
}

IssueDetailModal #idm-dialog {
    width: 80;
    max-width: 90%;
    height: 36;
    max-height: 90%;
    padding: 1 0;
    layout: vertical;
    border-title-color: $primary;
    border-title-style: bold;
}

IssueDetailModal #idm-scroll {
    width: 100%;
    height: 1fr;
    scrollbar-gutter: stable;
}

IssueDetailModal #idm-body {
    width: 100%;
    height: auto;
    padding: 0 3;
}

IssueDetailModal .idm-title {
    width: 1fr;
    text-style: bold;
    color: $text;
    padding-bottom: 1;
}
IssueDetailModal .idm-content {
    width: 100%;
    height: auto;
    padding: 0;
}
IssueDetailModal .idm-muted {
    width: 100%;
    height: auto;
    color: $text-muted;
}

/* key, value rows (shared detail_row widget) */
IssueDetailModal .detail-row {
    width: 100%;
    height: auto;
}
IssueDetailModal .detail-key {
    width: 17;
    color: $text-muted;
}
IssueDetailModal .detail-value {
    width: 1fr;
    color: $text;
}
IssueDetailModal .cf-text {
    width: 100%;
    height: auto;
    padding: 0;
}
IssueDetailModal .detail-gap {
    width: 100%;
    height: 1;
}
