/* Search bar on top */
ProjectHomeScreen #screen-body {
    layout: vertical;
    padding: 1 2;
}
ProjectHomeScreen #hub-search-row {
    width: 100%;
    height: auto;
}
ProjectHomeScreen #hub-search {
    width: 1fr;
    background: $background;
    border-title-style: bold;
}
/* Keep the background flat on focus */
ProjectHomeScreen #hub-search:focus {
    background: $background;
    background-tint: transparent;
}
/* ⚙ filter button is accented while a non-default filter is active */
ProjectHomeScreen #hub-filter.-filter-active {
    border: round $accent;
    color: $accent;
}
/* Three columns
 - [1] the swappable list (50%)
 - [2] Details (40%)
 - [3] Activity (10%)
 */
ProjectHomeScreen #hub-grid {
    width: 100%;
    height: 1fr;
    layout: grid;
    grid-size: 3 1;
    grid-columns: 4fr 3fr 1fr;
    grid-rows: 1fr;
    grid-gutter: 1;
}
/* CTRL+W (or other context that doesnt use activity): [3] Activity is dropped */
ProjectHomeScreen.-activity-closed #hub-grid,
ProjectHomeScreen.-no-timeline #hub-grid,
ProjectHomeScreen.-h-narrow #hub-grid {
    grid-size: 2 1;
    grid-columns: 1fr 1fr;
}
ProjectHomeScreen.-activity-closed #hub-activity,
ProjectHomeScreen.-no-timeline #hub-activity,
ProjectHomeScreen.-h-narrow #hub-activity {
    display: none;
}
/* CTRL+F: expands [1] to full width */
ProjectHomeScreen.-expanded #hub-grid {
    grid-size: 1 1;
    grid-columns: 1fr;
    grid-gutter: 0;
}
ProjectHomeScreen.-expanded #hub-detail,
ProjectHomeScreen.-expanded #hub-activity {
    display: none;
}

/* [1] Issues box */
ProjectHomeScreen .hub-box {
    width: 100%;
    height: 100%;
    padding: 0 1;
    border-title-color: $primary;
    border-subtitle-color: $text-muted;
}
ProjectHomeScreen #hub-issues-box:focus-within {
    border: round $accent;
    border-title-color: $accent;
}

ProjectHomeScreen #hub-issues-box {
    padding: 0 1 0 1;
}

/* The swappable list host that fills the [1] box */
ProjectHomeScreen .hub-list-host {
    width: 100%;
    height: 1fr;
}

/* [2] Details */
ProjectHomeScreen #hub-detail {
    width: 100%;
    height: 100%;
    border: round $primary;
    border-title-color: $primary;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
}
ProjectHomeScreen #hub-detail:focus-within {
    border: round $accent;
    border-title-color: $accent;
}
/* Scroll should live on the outer box so its scrollbar sits at the edge. 
If you dont do this, the scroll will be pushed inside with the padding. */
ProjectHomeScreen #hub-detail-main {
    width: 1fr;
    height: 100%;
    scrollbar-gutter: stable;
}
ProjectHomeScreen #hub-detail-main-inner {
    width: 100%;
    height: auto;
    padding: 1 2;
}
/* [3] Activity */
ProjectHomeScreen #hub-activity {
    width: 100%;
    height: 100%;
    border: round $primary;
    border-title-color: $primary;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
}
ProjectHomeScreen #hub-activity:focus-within {
    border: round $accent;
    border-title-color: $accent;
}
ProjectHomeScreen #hub-activity-scroll {
    width: 100%;
    height: 100%;
    scrollbar-gutter: stable;
}
ProjectHomeScreen #hub-activity-inner {
    width: 100%;
    height: auto;
    padding: 1 1;
}
ProjectHomeScreen .hub-timeline-title {
    width: 100%;
    text-style: bold;
    color: $text;
    padding-bottom: 1;
}
ProjectHomeScreen .hub-timeline-event {
    width: 100%;
    height: auto;
    color: $text;
}
/* One event groups its ● line + meta + change lines, the node spaces events. */
ProjectHomeScreen .hub-timeline-node {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}
ProjectHomeScreen .hub-timeline-meta {
    width: 100%;
    height: auto;
    color: $text-muted;
}
/* The before -> after detail of an event (e.g. a transition), not muted so it
   reads more prominently than the time/actor line. */
ProjectHomeScreen .hub-timeline-change {
    width: 100%;
    height: auto;
    color: $text;
}

ProjectHomeScreen .hub-table {
    height: 1fr;
    border: none;
}
/* Sprint's issue sub-list lives inside the detail body */
ProjectHomeScreen .hub-sprint-issues {
    height: auto;
    max-height: 18;
    margin-top: 1;
}
ProjectHomeScreen .hub-muted {
    width: 100%;
    height: auto;
    color: $text-muted;
    padding: 1;
}
/* Text when [1] is empty */
ProjectHomeScreen .hub-list-empty {
    width: 100%;
    height: auto;
    color: $text-muted;
    padding: 2 1 1 2;
}
ProjectHomeScreen .hub-title-row {
    width: 100%;
    height: auto;
    padding-bottom: 1;
}
ProjectHomeScreen .hub-detail-title {
    width: 1fr;
    text-style: bold;
    color: $text;
}
/* Single line gap (between a title and detail rows) */
ProjectHomeScreen .hub-detail-spacer {
    width: 100%;
    height: 1;
}
/* Issue body, rendered as Markdown */
ProjectHomeScreen .hub-content {
    width: 100%;
    height: auto;
    padding: 0;
}

/* The inline ✎ / ⇄ action buttons that sit at the right edge of a detail row.
   TextButton is borderless, accent it on hover/focus to show it's actionable. */
ProjectHomeScreen .hub-row-action {
    width: auto;
    min-width: 3;
    margin: 0 0 0 1;
    color: $text-muted;
}
ProjectHomeScreen .hub-row-action:hover {
    color: $accent;
}
ProjectHomeScreen .hub-row-action:focus {
    color: $accent;
    text-style: bold;
}

/* Reviewers section in the custom field area. 
  - Bold header + '+', one reviewer per row (name · status chip · ✕)
  - Right-aligned action button
  - Button reads 'Submit review' when the current user is a reviewer, else 'Request review' 
*/
ProjectHomeScreen .hub-reviewer-header {
    width: 100%;
    height: auto;
    margin-top: 1;
}
ProjectHomeScreen .hub-reviewer-title {
    width: 1fr;
    text-style: bold;
    color: $text;
}
ProjectHomeScreen .hub-reviewer-row {
    width: 100%;
    height: auto;
}
ProjectHomeScreen .hub-reviewer-name {
    width: 1fr;
    color: $text;
}
ProjectHomeScreen .hub-reviewer-status {
    width: auto;
    margin: 0 1;
}
ProjectHomeScreen .hub-request-row {
    width: 100%;
    height: auto;
    align-horizontal: right;
    margin-top: 1;
}
/* Plain text button sized to its label. */
ProjectHomeScreen .hub-request-btn {
    min-width: 0;
    margin-right: 3;
}

/* Children hierarchy section, below the reviewers. 
  - Bold 'Children' header + '+', then one link row per child (link · ✕)
  - Mirrors the reviewers section's spacing
  - Parent renders as a plain detail-row above
*/
ProjectHomeScreen .hub-hier-header {
    width: 100%;
    height: auto;
    margin-top: 1;
}
ProjectHomeScreen .hub-hier-title {
    width: 1fr;
    text-style: bold;
    color: $text;
}
ProjectHomeScreen .hub-hier-row {
    width: 100%;
    height: auto;
}

/* Comments section in the detail pane
  - Header
  - Loaded comments
  - Add-comment form
  - Replies are indented (see .hub-reply-block) 
*/
ProjectHomeScreen .hub-section-title {
    width: 100%;
    text-style: bold;
    color: $text;
    padding-top: 1;
}
/* Section header with an inline action button on the right */
ProjectHomeScreen .hub-open-header {
    width: 100%;
    height: auto;
    padding-top: 1;
}
ProjectHomeScreen .hub-open-title {
    width: 1fr;
    text-style: bold;
    color: $text;
}
ProjectHomeScreen .hub-comments {
    width: 100%;
    height: auto;
}
ProjectHomeScreen .hub-comment-meta {
    width: 100%;
    height: auto;
    color: $text-muted;
    padding-top: 1;
}
/* Comment body, rendered as Markdown (a deleted body is a plain Static) */
ProjectHomeScreen .hub-comment-body {
    width: 100%;
    height: auto;
    padding: 0;
}
ProjectHomeScreen .hub-comment-body MarkdownParagraph {
    margin: 0 0 1 0;
}
/* Reply, indented under its parent with a left-border "thread rail" marking
   the nesting depth (replies are capped at single level depth) */
ProjectHomeScreen .hub-reply-block {
    width: 100%;
    height: auto;
    margin-left: 1;
    padding-left: 1;
    border-left: solid $primary;
}
/* A root comment's meta line paired with its ↳ reply action */
ProjectHomeScreen .hub-comment-head {
    width: 100%;
    height: auto;
    padding-top: 1;
}
ProjectHomeScreen .hub-comment-head .hub-comment-meta {
    width: 1fr;
    padding-top: 0;
}
ProjectHomeScreen .hub-comment-form {
    width: 100%;
    height: auto;
    padding-top: 1;
}
ProjectHomeScreen .hub-comment-input {
    width: 1fr;
}
ProjectHomeScreen #hub-comment-compose {
    width: 100%;
    height: auto;
}
/* The replying banner shown above the input */
ProjectHomeScreen .hub-reply-banner {
    width: 100%;
    height: auto;
    padding: 0 1;
    background: $panel;
}
ProjectHomeScreen .hub-reply-target {
    width: 1fr;
    color: $text-muted;
}

/* key:value rows in the detail pane (shared detail_row widget) */
ProjectHomeScreen .detail-row {
    width: 100%;
    height: auto;
}
ProjectHomeScreen .detail-key {
    width: 17;
    color: $text-muted;
}
ProjectHomeScreen .detail-value {
    width: 1fr;
    color: $text;
}
