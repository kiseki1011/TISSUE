OptionModal {
    align: center middle;
    background: $background 60%;
}

#option-modal-dialog {
    width: 64;
    height: auto;
    border-title-align: center;
    border-title-color: $accent;
    border-subtitle-align: center;
    border-subtitle-color: $text-muted;
    padding: 1 3;

    /* Split the two tab buttons evenly across the dialog width */
    Tab {
        width: 1fr;
        text-align: center;
    }
}

#info-tab {
    .info-section {
        height: auto;
        margin-top: 1;
    }

    .info-section-header {
        color: $accent;
        text-style: bold;
        margin-bottom: 1;
    }

    .info-line {
        height: 1;
        padding-left: 2;
    }
}
