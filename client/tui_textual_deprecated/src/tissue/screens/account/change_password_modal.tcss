ChangePasswordModal {
    align: center middle;
    background: $background 60%;
}

#change-password-dialog {
    width: 64;
    max-width: 90%;
    min-width: 50;
    height: auto;
    max-height: 90%;
    padding: 0;
    border-title-align: center;
    border-title-color: $accent;
    border-subtitle-align: center;
    border-subtitle-color: $text-muted;
    overflow-y: auto;
}

#change-password-form {
    width: 100%;
    height: auto;
    padding: 2 4;

    .input-field {
        width: 100%;
    }

    #change-password-buttons {
        width: 100%;
        height: auto;
        align-horizontal: right;
        margin-top: 1;

        Button {
            margin-left: 1;
            min-width: 12;
        }
    }
}
