LogoutModal {
    align: center middle;
    background: $background 60%;
}

#logout-dialog {
    width: 56;
    max-width: 90%;
    min-width: 44;
    height: auto;
    min-height: 12;
    max-height: 90%;
    padding: 0;
    border-title-align: center;
    border-title-color: $warning;
    border-subtitle-align: center;
    border-subtitle-color: $text-muted;
}

#logout-form {
    width: 100%;
    height: auto;
    padding: 2 4;

    #logout_warning {
        width: 100%;
        height: auto;
        padding: 0 0 1 0;
        color: $warning;
        text-align: left;
    }

    #logout-buttons {
        width: 100%;
        height: auto;
        align-horizontal: right;
        margin-top: 1;

        Button {
            margin-left: 1;
            min-width: 12;
        }
    }
}
